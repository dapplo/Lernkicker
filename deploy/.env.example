# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Auth key from https://login.tailscale.com/admin/settings/keys (tagged with tag:lernkicker, not ephemeral).
# Only needed until the node has joined; the state is kept in ./tailscale.
TS_AUTHKEY=tskey-auth-...

# Image tag: latest, or a version such as 1.0.0
LERNKICKER_TAG=latest

# Only for compose.tsdproxy.yaml: the port on the NAS (any free one)
LERNKICKER_PORT=8080

# The admin account is created on the setup page at the first visit. No settings needed.
