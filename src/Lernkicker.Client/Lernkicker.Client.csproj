<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);LINKED_IN_CLIENT</DefineConstants>
  </PropertyGroup>

  <!-- Driving adapter for people: the PWA for children and parents. Talks to the server only through Lernkicker.Contracts. -->

  <PropertyGroup>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- UI languages; the texts live in Resources/Strings.*.resx -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lernkicker.Contracts\Lernkicker.Contracts.csproj" />
    <!-- Lesson practice checks typed vocabulary the same way as the quiz grader; the client references no domain -->
    <Compile Include="..\Lernkicker.Domain\Quizzes\Spelling.cs" Link="Services\Spelling.cs" />
    <!-- Reaction games played alone make their rounds and points on the device, the same way the server does
         (in the namespace Lernkicker.Client.Reaction, see LINKED_IN_CLIENT) -->
    <Compile Include="..\Lernkicker.Domain\Multiplayer\ReactionRounds.cs" Link="Services\ReactionRounds.cs" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
