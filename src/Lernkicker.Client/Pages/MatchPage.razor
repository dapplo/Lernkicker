@page "/play/{Id:guid}"
@implements IAsyncDisposable
@inject Api Api
@inject PlayConnection Connection
@inject NavigationManager Navigation
@inject Sounds Sounds

@* One game with others. The server checks every move; this page shows what the child may see and updates itself *@

<PageTitle>@(_match is null ? L["Play.Title"] : L[$"Play.Game.{_match.Match.Game}"]) · Lernkicker</PageTitle>

<header class="practice-header">
    <a href="play" class="close" aria-label="@L["Play.BackToLobby"]">✕</a>
    <span>@L["Play.Title"]</span>
</header>

@if (_match is null)
{
    <Messages Errors="@_errors" />
    @if (_errors is null)
    {
        <p class="loading-text">@L["Common.OneMoment"]</p>
    }
    else
    {
        <a class="btn" href="play">@L["Play.BackToLobby"]</a>
    }
}
else
{
    var match = _match.Match;
    <h1><span aria-hidden="true">@PlayGames.Icon(match.Game)</span> @L[$"Play.Game.{match.Game}"]</h1>
    <p class="play-players">@string.Join(" · ", match.Players.Select(p => p.Seat == match.MySeat ? L["Play.You"].Value : p.Name))</p>
    <p class="play-status @(match.MyTurn ? "my-turn" : "")" role="status" aria-live="polite">
        @(_match.Resigned is { } resigned && match.Status == "finished" && (resigned == match.MySeat || match.Winner == match.MySeat)
            ? resigned == match.MySeat ? L["Play.YouGaveUp"] : L["Play.GaveUp", match.Players.FirstOrDefault(p => p.Seat == resigned)?.Name ?? "?"]
            : PlayGames.Status(L, match))
    </p>
    <Messages Errors="@_errors" />

    <div class="match-board">
    @if (_ending is { } ending)
    {
        @* For a few seconds over the board when the game ends while the child watches (wwwroot/animations) *@
        <div class="game-ending @ending" data-lottie="@ending" aria-hidden="true" @key="ending"></div>
    }
    @switch (_match.View)
    {
        case BattleshipViewDto battleship:
            <BattleshipGame View="@battleship" MySeat="@(match.MySeat ?? 0)" Opponent="@Opponent" Busy="@_busy" Move="Move" />
            break;
        case ConnectFourViewDto connectFour:
            <ConnectFourGame View="@connectFour" MySeat="@(match.MySeat ?? 0)" Opponent="@Opponent" Busy="@_busy" Move="Move" />
            break;
        case CheckersViewDto checkers:
            <CheckersGame View="@checkers" Opponent="@Opponent" Busy="@_busy" Move="Move" />
            break;
        case MauMauViewDto mauMau:
            <MauMauGame View="@mauMau" Players="@match.Players" MySeat="@(match.MySeat ?? 0)" Busy="@_busy" Move="Move" />
            break;
        case ChessViewDto chess:
            <ChessGame View="@chess" Opponent="@Opponent" Busy="@_busy" Move="Move" />
            break;
        case null when match.Status == "waiting":
            <div class="empty">
                <div class="ball" aria-hidden="true">⏳</div>
                @if (match.Seats > 2)
                {
                    <p><b>@L["Play.SeatsTaken", match.Players.Count, match.Seats]</b></p>
                }
                <p>@(match.Seats > 2 ? L["Play.WaitingHintMany", match.MinPlayers] : L["Play.WaitingHint"])</p>
            </div>
            break;
    }
    </div>

    <div class="buttons">
        <a class="btn quiet" href="play">@L["Play.BackToLobby"]</a>
        @if (match.Status == "waiting" && match.MySeat == 0 && match.Seats > 2)
        {
            <button class="btn" disabled="@(_busy || match.Players.Count < match.MinPlayers)" @onclick="Start">@L["Play.StartNow"]</button>
        }
        @if (match.Status == "waiting")
        {
            <button class="btn quiet" disabled="@_busy" @onclick="Leave">@(match.MySeat == 0 ? L["Play.CloseTable"] : L["Play.LeaveTable"])</button>
        }
    </div>

    @if (match.Status == "playing" && !match.Abandoned && !(_match.View is MauMauViewDto { } mau && mau.Out.Contains(match.MySeat ?? -1)))
    {
        @* Tucked away with a second step, so nobody gives up by accident *@
        <details class="grown-ups">
            <summary>@L["Play.GiveUp"]</summary>
            <p>@L["Play.GiveUpQuestion"]</p>
            <button class="btn danger" disabled="@_busy" @onclick="Resign">@L["Play.GiveUpYes"]</button>
        </details>
    }
}

@code {
    private MatchDto? _match;
    private IReadOnlyList<string>? _errors;
    private bool _busy;
    private bool _connected;
    private string? _ending;

    [Parameter]
    public Guid Id { get; set; }

    private string Opponent => _match?.Match.Players.FirstOrDefault(p => p.Seat != _match.Match.MySeat)?.Name ?? "?";

    protected override async Task OnInitializedAsync()
    {
        Connection.MatchChanged += Changed;
        _connected = true;
        await Connection.AcquireAsync();
    }

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        try
        {
            Arrive(await Api.Match(Id));
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("");
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }

    private Task Changed(Guid id) => id != Id ? Task.CompletedTask : InvokeAsync(async () =>
    {
        // A closed table is gone; back to the lobby
        try
        {
            Arrive(await Api.Match(Id));
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.NotFound)
        {
            Navigation.NavigateTo("play");
            return;
        }
        catch (ApiException)
        {
            // Keep what is shown; the next change or a reload brings it up to date
        }

        StateHasChanged();
    });

    private Task Move(MoveDto move) => Run(async () => Arrive(await Api.Move(Id, move)));

    /// <summary>
    /// Takes a new state of the match. When it just ended while the child watched, a victory, defeat or draw animation
    /// with its tune plays over the board. Not for the one who gave up, not for a table nobody finished, and with three
    /// or more players only for the winner.
    /// </summary>
    private void Arrive(MatchDto next)
    {
        var before = _match;
        _match = next;
        var m = next.Match;
        if (before?.Match.Status != "playing" || m.Status != "finished" || m.Abandoned || next.Resigned is { } r && r == m.MySeat)
        {
            return;
        }

        var ending = m.Winner is null ? "draw" : m.Winner == m.MySeat ? "victory" : m.Seats > 2 ? null : "defeat";
        if (ending is not null)
        {
            // Battleship lets the last ship sink first
            _ = Celebrate(ending, next.View is BattleshipViewDto ? 1800 : 500);
        }
    }

    private async Task Celebrate(string ending, int delay)
    {
        await Task.Delay(delay);
        _ending = ending;
        await InvokeAsync(StateHasChanged);
        await Sounds.Play(ending switch { "victory" => ("win", 0), "defeat" => ("lose", 0), _ => ("place", 0) });
        await Task.Delay(3600);
        if (_ending == ending)
        {
            _ending = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task Start() => Run(async () => _match = await Api.StartTable(Id));

    private Task Resign() => Run(async () => Arrive(await Api.Resign(Id)));

    private Task Leave() => Run(async () =>
    {
        await Api.LeaveTable(Id);
        Navigation.NavigateTo("play");
    });

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        _errors = null;
        try
        {
            await action();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    public ValueTask DisposeAsync()
    {
        Connection.MatchChanged -= Changed;
        if (_connected)
        {
            Connection.Release();
        }

        return ValueTask.CompletedTask;
    }
}
