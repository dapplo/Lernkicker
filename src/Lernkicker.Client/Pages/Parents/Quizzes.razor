@page "/parents/quizzes"
@inject Api Api
@inject NavigationManager Navigation
@inject UploadFiles Files

<PageTitle>@L["Quizzes.Title"] · Lernkicker</PageTitle>

<ParentsNav />
<h1>@L["Quizzes.Title"]</h1>

<section class="box">
    <h2>@L["Quizzes.Upload"]</h2>
    <p class="hint">@((MarkupString)L["Quizzes.UploadHint"].Value)</p>
    <p class="hint">@L["Upload.PicturesHint"]</p>
    <label class="file">
        @L["Upload.ChooseFiles"]
        <InputFile multiple accept=".json,application/json,.zip,application/zip,image/*" OnChange="FilesChosen" disabled="@_busy" />
    </label>
    @if (_shrinking)
    {
        <p class="loading-text" role="status">@L["Upload.Shrinking"]</p>
    }
    <AiHelp />
    <details>
        <summary>@L["Quizzes.OrPaste"]</summary>
        <textarea rows="8" @bind="_json" @bind:event="oninput" spellcheck="false" placeholder='{ "format": "quiz/v1", … }'></textarea>
        <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_json))" @onclick="() => Upload(_json)">@L["Quizzes.UploadButton"]</button>
    </details>
    @if (_uploaded is { } uploaded)
    {
        <p class="ok" role="status">@L["Quizzes.Saved", uploaded.Title, uploaded.Version, uploaded.MaxPoints]</p>
    }
    <Messages Errors="@_errors" />
</section>

@if (_quizzes is null)
{
    <p class="loading-text">@L["Common.OneMoment"]</p>
}
else if (_quizzes.Count == 0)
{
    <p>@L["Quizzes.None"]</p>
}
else
{
    <ul class="list">
        @foreach (var quiz in _quizzes)
        {
            <li class="@Display.SubjectClass(quiz.Subject)">
                <div>
                    <b>@quiz.Title</b>
                    <small>@L["Quizzes.Details", Display.Subject(quiz.Subject), quiz.GradeLevel, quiz.MaxPoints, quiz.Version, Display.Date(quiz.UploadedAt)]</small>
                    @if (quiz.Shared)
                    {
                        <small class="shared-badge">@L["Share.Badge"]</small>
                    }
                </div>
                @if (_deleting == quiz.QuizId)
                {
                    <span class="buttons">
                        <button class="btn danger" @onclick="() => Delete(quiz.QuizId)">@L["Quizzes.ReallyDelete"]</button>
                        <button class="btn quiet" @onclick="() => _deleting = null">@L["Common.Cancel"]</button>
                    </span>
                }
                else
                {
                    <span class="buttons">
                        <a class="btn quiet" href="parents/preview/quiz/@Uri.EscapeDataString(quiz.QuizId)">@L["Preview.Button"]</a>
                        <button class="btn quiet" @onclick="() => Share(quiz.QuizId, !quiz.Shared)">@L[quiz.Shared ? "Share.Stop" : "Share.Start"]</button>
                        <button class="btn quiet" @onclick="() => _deleting = quiz.QuizId">@L["Common.Delete"]</button>
                    </span>
                }
            </li>
        }
    </ul>
    <p class="hint">@L["Quizzes.ArchiveHint"]</p>
    <p class="hint">@L["Share.Hint"]</p>
}

@code {
    private List<QuizOverview>? _quizzes;
    private string _json = "";
    private QuizOverview? _uploaded;
    private IReadOnlyList<string>? _errors;
    private string? _deleting;
    private bool _busy;
    private bool _shrinking;

    // The server takes at most 100 files per upload, the JSON included
    private const int MaxFiles = 100;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _quizzes = await Api.Quizzes();
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("parents");
        }
    }

    private async Task FilesChosen(InputFileChangeEventArgs e)
    {
        _errors = null;
        if (e.FileCount > MaxFiles)
        {
            _errors = [L["Error.upload.tooManyFiles"]];
            return;
        }

        MultipartFormDataContent form;
        _shrinking = true;
        try
        {
            form = await Files.PrepareAsync(e.GetMultipleFiles(MaxFiles));
        }
        catch (FileTooLargeException tooLarge)
        {
            _errors = [L["Upload.FileTooLarge", tooLarge.FileName]];
            return;
        }
        finally
        {
            _shrinking = false;
        }

        using (form)
        {
            await Upload(() => Api.UploadQuiz(form));
        }
    }

    private Task Upload(string json) => Upload(() => Api.UploadQuiz(json));

    private async Task Upload(Func<Task<QuizOverview>> send)
    {
        _busy = true;
        _uploaded = null;
        _errors = null;
        try
        {
            _uploaded = await send();
            _json = "";
            _quizzes = await Api.Quizzes();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Share(string quizId, bool shared)
    {
        _errors = null;
        try
        {
            await Api.ShareQuiz(quizId, shared);
            _quizzes = await Api.Quizzes();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }

    private async Task Delete(string quizId)
    {
        _deleting = null;
        try
        {
            await Api.DeleteQuiz(quizId);
            _quizzes = await Api.Quizzes();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }
}
