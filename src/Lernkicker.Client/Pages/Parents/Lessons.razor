@page "/parents/lessons"
@inject Api Api
@inject NavigationManager Navigation

<PageTitle>@L["Lessons.Title"] · Lernkicker</PageTitle>

<p><a href="parents">← @L["Common.Back"]</a></p>
<h1>@L["Lessons.Title"]</h1>
<p class="subtitle">@L["Lessons.Intro"]</p>

<section class="box">
    <h2>@L["Lessons.Upload"]</h2>
    <p class="hint">@((MarkupString)L["Lessons.UploadHint"].Value)</p>
    <label class="file">
        @L["Quizzes.ChooseFile"]
        <InputFile accept=".json,application/json" OnChange="FileChosen" />
    </label>
    <details>
        <summary>@L["Quizzes.OrPaste"]</summary>
        <textarea rows="8" @bind="_json" @bind:event="oninput" spellcheck="false" placeholder='{ "format": "lesson/v1", … }'></textarea>
        <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_json))" @onclick="() => Upload(_json)">@L["Quizzes.UploadButton"]</button>
    </details>
    @if (_uploaded is { } uploaded)
    {
        <p class="ok" role="status">@L["Lessons.Saved", uploaded.Title]</p>
    }
    <Messages Errors="@_errors" />
</section>

@if (_lessons is null)
{
    <p class="loading-text">@L["Common.OneMoment"]</p>
}
else if (_lessons.Count == 0)
{
    <p>@L["Lessons.None"]</p>
}
else
{
    <ul class="list">
        @foreach (var lesson in _lessons)
        {
            <li class="@Display.SubjectClass(lesson.Subject)">
                <div>
                    <b>@lesson.Title</b>
                    <small>@L["Lessons.Details", Display.Subject(lesson.Subject), lesson.GradeLevel, lesson.Blocks, Display.Date(lesson.UploadedAt)]</small>
                    @if (lesson.Shared)
                    {
                        <small class="shared-badge">@L["Share.Badge"]</small>
                    }
                </div>
                @if (_deleting == lesson.LessonId)
                {
                    <span class="buttons">
                        <button class="btn danger" @onclick="() => Delete(lesson.LessonId)">@L["Quizzes.ReallyDelete"]</button>
                        <button class="btn quiet" @onclick="() => _deleting = null">@L["Common.Cancel"]</button>
                    </span>
                }
                else
                {
                    <span class="buttons">
                        <a class="btn quiet" href="parents/preview/lesson/@Uri.EscapeDataString(lesson.LessonId)">@L["Preview.Button"]</a>
                        <button class="btn quiet" @onclick="() => Share(lesson.LessonId, !lesson.Shared)">@L[lesson.Shared ? "Share.Stop" : "Share.Start"]</button>
                        <button class="btn quiet" @onclick="() => _deleting = lesson.LessonId">@L["Common.Delete"]</button>
                    </span>
                }
            </li>
        }
    </ul>
    <p class="hint">@L["Lessons.DeleteHint"]</p>
    <p class="hint">@L["Share.Hint"]</p>
}

@code {
    private List<LessonOverview>? _lessons;
    private string _json = "";
    private LessonOverview? _uploaded;
    private IReadOnlyList<string>? _errors;
    private string? _deleting;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _lessons = await Api.Lessons();
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("parents");
        }
    }

    private async Task FileChosen(InputFileChangeEventArgs e)
    {
        _errors = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(ApiLimits.LessonMaxBytes));
            await Upload(await reader.ReadToEndAsync());
        }
        catch (IOException)
        {
            _errors = [L["Error.lesson.tooLarge"]];
        }
    }

    private async Task Upload(string json)
    {
        _busy = true;
        _uploaded = null;
        _errors = null;
        try
        {
            _uploaded = await Api.UploadLesson(json);
            _json = "";
            _lessons = await Api.Lessons();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Share(string lessonId, bool shared)
    {
        _errors = null;
        try
        {
            await Api.ShareLesson(lessonId, shared);
            _lessons = await Api.Lessons();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }

    private async Task Delete(string lessonId)
    {
        _deleting = null;
        try
        {
            await Api.DeleteLesson(lessonId);
            _lessons = await Api.Lessons();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }
}
