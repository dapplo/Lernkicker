@page "/parents/lessons"
@inject Api Api
@inject NavigationManager Navigation
@inject UploadFiles Files

<PageTitle>@L["Lessons.Title"] · Lernkicker</PageTitle>

<ParentsNav />
<h1>@L["Lessons.Title"]</h1>
<p class="subtitle">@L["Lessons.Intro"]</p>

@* Folded away once there is something in the list, which then stays in view *@
<details class="box upload" open="@(_lessons is { Count: 0 })">
    <summary>@L["Lessons.Upload"]</summary>
    <p class="hint">@((MarkupString)L["Lessons.UploadHint"].Value)</p>
    <p class="hint">@L["Upload.PicturesHint"]</p>
    <label class="file">
        @L["Upload.ChooseFiles"]
        @* No accept filter: phones report zips as application/x-zip-compressed or octet-stream and grey them out; the server checks the files *@
        <InputFile multiple OnChange="FilesChosen" disabled="@_busy" />
    </label>
    @if (_shrinking)
    {
        <p class="loading-text" role="status">@L["Upload.Shrinking"]</p>
    }
    <AiHelp />
    <details>
        <summary>@L["Quizzes.OrPaste"]</summary>
        <textarea rows="8" @bind="_json" @bind:event="oninput" spellcheck="false" placeholder='{ "format": "lesson/v1", … }'></textarea>
        <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_json))" @onclick="() => Upload(_json)">@L["Quizzes.UploadButton"]</button>
    </details>
</details>
@if (_uploaded is { } uploaded)
{
    <p class="ok" role="status">@L["Lessons.Saved", uploaded.Title]</p>
}
<Messages Errors="@_errors" />

@if (_lessons is null)
{
    <p class="loading-text">@L["Common.OneMoment"]</p>
}
else if (_lessons.Count == 0)
{
    <p>@L["Lessons.None"]</p>
}
else
{
    @if (_lessons.Count > 1)
    {
        <ListFilterBar Filter="_filter" Subjects="_lessons.Select(i => i.Subject)" Grades="_lessons.Select(i => i.GradeLevel)"
                       Shown="Shown.Count()" Total="_lessons.Count" OnChange="StateHasChanged" />
    }
    <ul class="list grid">
        @foreach (var lesson in Shown)
        {
            <li class="@Display.SubjectClass(lesson.Subject)">
                <div>
                    <b>@lesson.Title</b>
                    <small>@L["Lessons.Details", Display.Subject(lesson.Subject), Display.Grade(lesson.GradeLevel), lesson.Blocks, Display.Date(DateOnly.FromDateTime(lesson.UploadedAt.LocalDateTime))]</small>
                    @if (lesson.Shared)
                    {
                        <small class="shared-badge">@L["Share.Badge"]</small>
                    }
                </div>
                @if (_deleting == lesson.LessonId)
                {
                    <span class="buttons">
                        <button class="btn danger small" @onclick="() => Delete(lesson.LessonId)">@L["Quizzes.ReallyDelete"]</button>
                        <IconButton Icon="✕" Label="@L["Common.Cancel"]" Class="quiet" OnClick="() => _deleting = null" />
                    </span>
                }
                else
                {
                    <span class="buttons">
                        <IconButton Icon="👁️" Label="@L["Preview.Button"]" Class="quiet" Href="@($"parents/preview/lesson/{Uri.EscapeDataString(lesson.LessonId)}")" />
                        <IconButton Icon="🌍" Label="@L[lesson.Shared ? "Share.Stop" : "Share.Start"]" Class="@(lesson.Shared ? "on" : "quiet")" OnClick="() => Share(lesson.LessonId, !lesson.Shared)" />
                        <IconButton Icon="🗑️" Label="@L["Common.Delete"]" Class="quiet" OnClick="() => _deleting = lesson.LessonId" />
                    </span>
                }
            </li>
        }
    </ul>
    <p class="hint">@L["Lessons.DeleteHint"]</p>
    <p class="hint">@L["Share.Hint"]</p>
}

@code {
    private List<LessonOverview>? _lessons;
    private string _json = "";
    private LessonOverview? _uploaded;
    private IReadOnlyList<string>? _errors;
    private string? _deleting;
    private readonly ListFilter _filter = new();
    private bool _busy;
    private bool _shrinking;

    private IEnumerable<LessonOverview> Shown => _lessons!.Where(i => _filter.Matches(i.Title, i.Topic, i.Subject, Display.Subject(i.Subject), i.GradeLevel));

    // The server takes at most 100 files per upload, the JSON included
    private const int MaxFiles = 100;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _lessons = await Api.Lessons();
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("parents");
        }
    }

    private async Task FilesChosen(InputFileChangeEventArgs e)
    {
        _errors = null;
        if (e.FileCount > MaxFiles)
        {
            _errors = [L["Error.upload.tooManyFiles"]];
            return;
        }

        MultipartFormDataContent form;
        _shrinking = true;
        try
        {
            form = await Files.PrepareAsync(e.GetMultipleFiles(MaxFiles));
        }
        catch (FileTooLargeException tooLarge)
        {
            _errors = [L["Upload.FileTooLarge", tooLarge.FileName]];
            return;
        }
        finally
        {
            _shrinking = false;
        }

        using (form)
        {
            await Upload(() => Api.UploadLesson(form));
        }
    }

    private Task Upload(string json) => Upload(() => Api.UploadLesson(json));

    private async Task Upload(Func<Task<LessonOverview>> send)
    {
        _busy = true;
        _uploaded = null;
        _errors = null;
        try
        {
            _uploaded = await send();
            _json = "";
            _lessons = await Api.Lessons();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Share(string lessonId, bool shared)
    {
        _errors = null;
        try
        {
            await Api.ShareLesson(lessonId, shared);
            _lessons = await Api.Lessons();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }

    private async Task Delete(string lessonId)
    {
        _deleting = null;
        try
        {
            await Api.DeleteLesson(lessonId);
            _lessons = await Api.Lessons();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }
}
