@page "/admin"
@inject Api Api

<PageTitle>@L["Admin.Title"] · Lernkicker</PageTitle>

<p><a href="parents">← @L["Common.Back"]</a></p>
<h1>@L["Admin.Title"]</h1>
<Messages Errors="@_errors" />

@if (_families is null)
{
    @if (_errors is null)
    {
        <p class="loading-text">@L["Common.OneMoment"]</p>
    }
}
else
{
    <section class="box">
        <h2>@L["Admin.Invite"]</h2>
        <form class="form" @onsubmit="Invite" @onsubmit:preventDefault>
            <label>@L["Admin.For"]
                <select @bind="_familyId">
                    <option value="">@L["Admin.NewFamily"]</option>
                    @foreach (var f in _families)
                    {
                        <option value="@f.Id">@L["Admin.AnotherParent", f.Name]</option>
                    }
                </select>
            </label>
            @if (string.IsNullOrEmpty(_familyId))
            {
                <label>@L["Admin.FamilyName"] <input @bind="_newFamily" maxlength="100" placeholder="@L["Admin.FamilyNamePlaceholder"]" /></label>
            }
            <button class="btn" type="submit">@L["Admin.CreateLink"]</button>
        </form>
        @if (_invitation is { } invitation)
        {
            <p>@L["Admin.SendLink", Display.Date(invitation.ExpiresAt)]</p>
            <p><input class="link" readonly value="@invitation.Link" /></p>
        }
    </section>

    <section class="box">
        <h2>@L["Admin.Families"]</h2>
        <table class="table">
            <thead><tr><th>@L["Admin.Family"]</th><th>@L["Admin.Parents"]</th><th>@L["Parents.Children"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in _families)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@f.Parents</td>
                        <td>@f.Children</td>
                        <td>
                            @if (_deleting == f.Id)
                            {
                                <button class="btn danger" @onclick="() => Delete(f.Id)">@L["Admin.DeleteWithData"]</button>
                            }
                            else
                            {
                                <button class="btn quiet" @onclick="() => _deleting = f.Id">@L["Common.DeleteEllipsis"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="hint">@L["Admin.TailnetOnly"]</p>
    </section>

    <section class="box">
        <h2>@L["Admin.Backup.Title"]</h2>
        <p>@L["Admin.Backup.Intro"]</p>
        <p><a class="btn" href="api/admin/backup" download>@L["Admin.Backup.Download"]</a></p>
        <p class="hint">@L["Admin.Backup.Hint"]</p>
    </section>

    @if (_bot is { } bot)
    {
        <section class="box">
            <h2>@L["Admin.Bot.Title"]</h2>
            @if (bot.FromFile)
            {
                <p>@(bot.BotUsername is { } name ? L["Admin.Bot.Running", name] : L["Admin.Bot.Starting"])</p>
                <p class="hint">@L["Admin.Bot.FromFile"]</p>
            }
            else
            {
                @if (bot.Configured)
                {
                    <p>@(bot.BotUsername is { } name ? L["Admin.Bot.Running", name] : L["Admin.Bot.Starting"])</p>
                    <p class="hint">@L["Admin.Bot.SetAt", Display.Date(bot.SetAt!.Value)]</p>
                }
                else
                {
                    <p>@L["Admin.Bot.Intro"]</p>
                }
                <form class="form" @onsubmit="SetToken" @onsubmit:preventDefault>
                    <label>@L["Admin.Bot.Token"] <input type="password" autocomplete="off" @bind="_token" placeholder="123456789:AA…" required /></label>
                    <p class="hint">@L["Admin.Bot.TokenHint"]</p>
                    <Messages Errors="@_botErrors" />
                    <p>
                        <button class="btn" type="submit" disabled="@_busy">@(bot.Configured ? L["Admin.Bot.Replace"] : L["Admin.Bot.Save"])</button>
                        @if (bot.Configured)
                        {
                            <button class="btn quiet" type="button" @onclick="RemoveToken" disabled="@_busy">@L["Admin.Bot.Remove"]</button>
                        }
                    </p>
                </form>
            }
        </section>
    }
}

@code {
    private List<FamilyOverview>? _families;
    private string _familyId = "", _newFamily = "";
    private InvitationCreatedResponse? _invitation;
    private Guid? _deleting;
    private IReadOnlyList<string>? _errors, _botErrors;
    private TelegramBotDto? _bot;
    private string _token = "";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _families = await Api.Families();
            _bot = await Api.TelegramBot();
        }
        catch (ApiException e)
        {
            _errors = e.Status == System.Net.HttpStatusCode.NotFound ? [L["Admin.TailnetOnly"]] : Display.Errors(e);
        }
    }

    private async Task Invite()
    {
        _errors = null;
        try
        {
            Guid? family = Guid.TryParse(_familyId, out var id) ? id : null;
            _invitation = await Api.CreateInvitation(new NewInvitation(family, family is null ? _newFamily : null));
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }

    private async Task SetToken()
    {
        _busy = true;
        _botErrors = null;
        try
        {
            await Api.SetBotToken(_token);
            _token = "";
            _bot = await Api.TelegramBot();
            // The bot needs a moment to start with the new token
            if (_bot.BotUsername is null)
            {
                await Task.Delay(1500);
                _bot = await Api.TelegramBot();
            }
        }
        catch (ApiException e)
        {
            _botErrors = Display.Errors(e);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveToken()
    {
        _busy = true;
        _botErrors = null;
        try
        {
            await Api.RemoveBotToken();
            _bot = await Api.TelegramBot();
        }
        catch (ApiException e)
        {
            _botErrors = Display.Errors(e);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Delete(Guid id)
    {
        _deleting = null;
        try
        {
            await Api.DeleteFamily(id);
            _families = await Api.Families();
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }
}
