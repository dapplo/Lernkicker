@page "/parents/library"
@inject Api Api
@inject NavigationManager Navigation

<PageTitle>@L["Library.Title"] · Lernkicker</PageTitle>

<ParentsNav />
<h1>@L["Library.Title"]</h1>
<p class="subtitle">@L["Library.Intro"]</p>

@if (_items is null)
{
    <p class="loading-text">@L["Common.OneMoment"]</p>
}
else if (_items.Count == 0)
{
    <p>@L["Library.Empty"]</p>
}
else
{
    <ListFilterBar Filter="_filter" Subjects="_items.Select(i => i.Subject)" Grades="_items.Select(i => i.GradeLevel)"
                   Shown="Filtered.Count()" Total="_items.Count" OnChange="StateHasChanged">
        <select @bind="_filter.Kind" aria-label="@L["Library.Kind"]">
            <option value="">@L["List.AllKinds"]</option>
            <option value="@SharedKinds.Quiz">@L["Library.Quizzes"]</option>
            <option value="@SharedKinds.Lesson">@L["Library.Lessons"]</option>
        </select>
    </ListFilterBar>
    <Messages Errors="@_errors" />
    <ul class="list grid">
        @foreach (var item in Filtered)
        {
            <li class="@Display.SubjectClass(item.Subject)">
                <div>
                    <b>@item.Title</b>
                    <small>@Details(item)</small>
                    @if (_copied.Contains(item.Id))
                    {
                        <small class="ok">@L["Library.CopiedShort"]</small>
                    }
                    else if (item.InMyLibrary)
                    {
                        <small>@L["Library.InMyLibrary"]</small>
                    }
                </div>
                <span class="buttons">
                    <IconButton Icon="👁️" Label="@L["Preview.Button"]" Class="quiet" Href="@($"parents/library/{item.Kind}/{item.Id}")" />
                    @if (!_copied.Contains(item.Id))
                    {
                        <IconButton Icon="@(item.InMyLibrary ? "🔄" : "📥")" Label="@L[item.InMyLibrary ? "Library.Update" : "Library.Copy"]" OnClick="() => Copy(item)" />
                    }
                </span>
            </li>
        }
    </ul>
}

@code {
    private List<SharedOverview>? _items;
    private readonly HashSet<Guid> _copied = [];
    private readonly ListFilter _filter = new();

    private IReadOnlyList<string>? _errors;

    private IEnumerable<SharedOverview> Filtered => _items!
        .Where(i => _filter.Kind == "" || i.Kind == _filter.Kind)
        .Where(i => _filter.Matches(i.Title, i.Topic, i.Subject, Display.Subject(i.Subject), i.GradeLevel));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Api.Library();
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("parents");
        }
    }

    private string Details(SharedOverview item) => L[item.Kind == SharedKinds.Quiz ? "Library.QuizDetails" : "Library.LessonDetails",
        Display.Subject(item.Subject), Display.Grade(item.GradeLevel), item.Size, Display.Date(item.SharedAt)];

    private async Task Copy(SharedOverview item)
    {
        _errors = null;
        try
        {
            if (item.Kind == SharedKinds.Quiz)
            {
                await Api.CopyQuiz(item.Id);
            }
            else
            {
                await Api.CopyLesson(item.Id);
            }

            _copied.Add(item.Id);
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }
}
