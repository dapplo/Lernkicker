@page "/practice/{AssignmentId:guid}"
@inject Api Api
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@L["Practice.Title"] · Lernkicker</PageTitle>

@if (_errors is not null)
{
    <Messages Errors="@_errors" />
    <a class="btn" href="">@L["Common.Back"]</a>
}
else if (_sheet is null || _drafts is null)
{
    <p class="loading-text">@L["Practice.Loading"]</p>
}
else if (_result is not null)
{
    <h1 lang="@_sheet.Language">@_sheet.Title</h1>
    <QuizResultView Result="@_result" Language="@_sheet.Language" />
    <div class="buttons">
        <button class="btn" @onclick="Again">@L["Practice.Again"]</button>
        <a class="btn quiet" href="">@L["Practice.ToOverview"]</a>
    </div>
}
else
{
    var draft = _drafts[_index];
    var open = _drafts.Sum(d => d.Open);
    var last = _index == _drafts.Count - 1;
    <header class="practice-header">
        <a href="" class="close" aria-label="@L["Practice.ToOverview"]">✕</a>
        <span lang="@_sheet.Language">@_sheet.Title</span>
    </header>
    <progress class="progress" max="@_drafts.Count" value="@(_index + 1)"></progress>
    <p class="counter">@L["Practice.Counter", _index + 1, _drafts.Count]</p>

    @* Every exercise as a number to jump to; open ones stand out, so nothing has to be searched by scrolling *@
    <nav class="exercise-nav" aria-label="@L["Practice.Exercises"]">
        @for (var i = 0; i < _drafts.Count; i++)
        {
            var number = i;
            var missing = _drafts[number].Open;
            <button type="button" class="@(number == _index ? "current" : "") @(missing > 0 ? "open" : "done")"
                    aria-current="@(number == _index ? "step" : null)"
                    aria-label="@(missing > 0 ? L["Practice.GoToOpen", number + 1, missing] : L["Practice.GoToDone", number + 1])"
                    @onclick="() => Show(number)">@(number + 1)</button>
        }
    </nav>

    @* The answers live in the draft, which ExerciseView fills. Its events bubble up here, so the numbers above and
       the "missing" hint below are redrawn with every answer instead of showing an old count. *@
    <div @onclick="Changed" @oninput="Changed" @onchange="Changed">
        <ExerciseView @key="draft" Draft="@draft" Language="@_sheet.Language" />
    </div>

    @if (last && open > 0)
    {
        <p class="hint">@(open == 1 ? L["Practice.OneOpen"] : L["Practice.SomeOpen", open])</p>
    }
    <div class="practice-bar">
        @if (_index > 0)
        {
            <button class="btn quiet" @onclick="() => Show(_index - 1)">@L["Common.Back"]</button>
        }
        @if (!last)
        {
            <button class="btn" @onclick="() => Show(_index + 1)">@L["Practice.Next"]</button>
        }
        else
        {
            <button class="btn goal" disabled="@_busy" @onclick="Submit">@L["Practice.Submit"]</button>
        }
    </div>
}

@code {
    private SheetDto? _sheet;
    private List<AnswerDraft>? _drafts;
    private QuizResultDto? _result;
    private IReadOnlyList<string>? _errors;
    private int _index;
    private bool _busy;
    private bool _scrollUp;

    [Parameter]
    public Guid AssignmentId { get; set; }

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        try
        {
            _sheet = await Api.Sheet(AssignmentId);
            _drafts = _sheet.Exercises.Select(AnswerDraft.For).ToList();
            _result = null;
            _index = 0;
        }
        catch (ApiException e) when (e.Status == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("");
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
    }

    private void Show(int index)
    {
        _index = Math.Clamp(index, 0, _drafts!.Count - 1);
        // Otherwise the next exercise starts where the last one ended: far down, at the buttons
        _scrollUp = true;
    }

    // Nothing to do: handling the event is what redraws the page
    private void Changed()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollUp)
        {
            _scrollUp = false;
            await Js.InvokeVoidAsync("lernkicker.scrollToTop");
        }
    }

    private async Task Submit()
    {
        _busy = true;
        try
        {
            var answers = _drafts!.ToDictionary(d => d.Exercise.Id, d => d.ToAnswer());
            _result = await Api.Submit(AssignmentId, answers);
            _scrollUp = true;
        }
        catch (ApiException e)
        {
            _errors = Display.Errors(e);
        }
        finally
        {
            _busy = false;
        }
    }

    // A fresh round reshuffles everything
    private Task Again()
    {
        _sheet = null;
        return Load();
    }
}
