@page "/"
@inject Api Api
@inject NavigationManager Navigation
@inject CurrentTheme Theme

<PageTitle>Lernkicker</PageTitle>

@if (_device is null)
{
    <p class="loading-text">@L["Common.OneMoment"]</p>
}
else if (!_device.Paired)
{
    <h1>@L["Home.Welcome"]</h1>
    <p>@L["Home.NotPaired"]</p>
    <PairForm Paired="Reload" />
    <p class="parents-link"><a href="parents">@L["Home.IAmAParent"]</a></p>
}
else if (_device.Locked)
{
    <h1>@L["Home.Hello", _device.ChildName ?? ""]</h1>
    <p class="error">@L["Home.Locked"]</p>
    <button class="btn" @onclick="Reload">@L["Home.TryAgain"]</button>
}
else if (_assignments is null)
{
    <h1>@L["Home.Hello", _device.ChildName ?? ""]</h1>
    <p>@L["Home.EnterPin"]</p>
    <PinPad Entered="Login" Error="@_error" Disabled="@_busy" />
}
else
{
    <h1>@L["Home.Hello", _device.ChildName ?? ""]</h1>
    @if (_assignments.Count == 0 && _lessons is not { Count: > 0 } && _lobby is not { Games.Count: > 0 })
    {
        <div class="empty">
            <div class="ball" aria-hidden="true">@Theme.Value.Icon</div>
            <p>@L["Home.NothingToDo"]</p>
        </div>
    }
    else if (_assignments.Count > 0)
    {
        <h2><span aria-hidden="true">@Display.QuizIcon</span> @L["Home.WhatToPractice"]</h2>
        <ul class="cards">
            @foreach (var assignment in _assignments)
            {
                <li>
                    <a class="card @Display.SubjectClass(assignment.Subject)" href="practice/@assignment.AssignmentId">
                        <span class="subject"><span class="kind" aria-hidden="true">@Display.QuizIcon</span> @Display.Subject(assignment.Subject)</span>
                        <span class="title">@assignment.Title</span>
                        @if (assignment.DueOn is { } due)
                        {
                            <span class="due">@L["Home.TestOn", Display.Due(due)]</span>
                        }
                        <span class="stars" aria-label="@L["Stars.Label", assignment.Stars]">@Display.Stars(assignment.Stars)</span>
                    </a>
                </li>
            }
        </ul>
    }
    @if (_lessons is { Count: > 0 })
    {
        <h2><span aria-hidden="true">@Display.LessonIcon</span> @L["Home.ToLearn"]</h2>
        <ul class="cards">
            @foreach (var lesson in _lessons)
            {
                <li>
                    <a class="card lesson @Display.SubjectClass(lesson.Subject)" href="learn/@lesson.AssignmentId">
                        <span class="subject"><span class="kind" aria-hidden="true">@Display.LessonIcon</span> @Display.Subject(lesson.Subject)</span>
                        <span class="title">@lesson.Title</span>
                        @if (lesson.DueOn is { } due)
                        {
                            <span class="due">@L["Lessons.Until", Display.Due(due)]</span>
                        }
                        <span class="known">@(lesson.Mode == "reference" ? L["Home.Reference"] : L["Home.Known", lesson.KnownBlocks, lesson.Blocks])</span>
                    </a>
                </li>
            }
        </ul>
    }
    @if (_lobby is { } lobby && (lobby.Games.Count > 0 || lobby.MyMatches.Count > 0))
    {
        var myTurn = lobby.MyMatches.Count(m => m.MyTurn);
        <h2><span aria-hidden="true">🎲</span> @L["Play.Title"]</h2>
        <ul class="cards">
            <li>
                <a class="card play-card @(myTurn > 0 ? "my-turn" : "")" href="play">
                    <span class="subject"><span aria-hidden="true">@string.Concat(lobby.Games.Select(PlayGames.Icon))</span> @string.Join(", ", lobby.Games.Select(g => L[$"Play.Game.{g}"].Value))</span>
                    <span class="title">@L["Play.ToLobby"]</span>
                    @if (myTurn > 0)
                    {
                        <span class="due">@(myTurn == 1 ? L["Play.YourTurnInOne"] : L["Play.YourTurnIn", myTurn])</span>
                    }
                    else if (lobby.Tables.Count > 0)
                    {
                        <span class="due">@L["Play.TablesOpen", lobby.Tables.Count]</span>
                    }
                </a>
            </li>
        </ul>
    }
    @if (_dates is { Count: > 0 })
    {
        <h2>@L["Home.NextDates"]</h2>
        <ul class="dates">
            @foreach (var date in _dates)
            {
                <li>
                    <span class="icon" aria-hidden="true">@Display.KindIcon(date.Kind)</span>
                    <span class="when">@Display.Due(date.Date)@(date.StartTime is null ? "" : ", " + Display.Times(date.StartTime, date.EndTime))</span>
                    <span class="what">@date.Title</span>
                </li>
            }
        </ul>
    }
    <p class="tip">@L["Home.FocusTip"]</p>
    @* Tucked away with a second step, so a child does not log out by accident *@
    <details class="grown-ups">
        <summary>@L["Home.ForParents"]</summary>
        @if (_confirmLogout)
        {
            <p>@L["Home.LogoutQuestion"]</p>
            <span class="buttons">
                <button class="btn danger" @onclick="Logout">@L["Home.LogoutYes"]</button>
                <button class="btn quiet" @onclick="() => _confirmLogout = false">@L["Common.Cancel"]</button>
            </span>
        }
        else
        {
            <button class="btn quiet" @onclick="() => _confirmLogout = true">@L["Common.Logout"]</button>
        }
    </details>
}

@code {
    private DeviceStatusResponse? _device;
    private List<MyAssignment>? _assignments;
    private List<MyLesson>? _lessons;
    private List<CalendarEntryDto>? _dates;
    private LobbyDto? _lobby;
    private string? _error;
    private bool _busy;
    private bool _confirmLogout;

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        _error = null;
        _device = await Api.DeviceStatus();
        Theme.Set(_device.Theme);
        if (!_device.Paired && await Api.SetupNeeded())
        {
            // A fresh server: the first visitor creates the admin
            Navigation.NavigateTo("setup", replace: true);
            return;
        }

        _assignments = _device is { Paired: true, Locked: false } ? await Api.MyAssignments() : null;
        _lessons = _assignments is null ? null : await Api.MyLessons();
        // Tests and lessons already have their card; the list shows the other dates
        _dates = _assignments is null ? null : (await Api.MyCalendar())?.Where(d => d.Source is not ("assignment" or "lesson")).ToList();
        _lobby = _assignments is null ? null : await Api.Lobby();
    }

    private async Task Login(string pin)
    {
        _busy = true;
        try
        {
            await Api.ChildLogin(pin);
            await Reload();
        }
        catch (ApiException e)
        {
            _error = Display.Errors(e)[0];
            if (e.Status == System.Net.HttpStatusCode.Locked)
            {
                _device = _device! with { Locked = true };
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Logout()
    {
        _confirmLogout = false;
        await Api.ChildLogout();
        await Reload();
    }
}
