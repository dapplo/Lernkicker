@* Shows one exercise of a quiz and records the child's answers in the draft. Quiz texts keep the quiz's language.
   Text fields record every keystroke (oninput), not only on blur: on phones the field often keeps focus while the
   child taps "Next" or "Hand in", so a change event would come too late or never. Autocorrect and spellcheck are off,
   so the keyboard does not suggest (and give away) the right spelling. *@

<section class="exercise" lang="@Language">
    @if (!Game)
    {
        <h2>@Draft.Exercise.Instruction <span class="points" lang="@UiLanguage.Current">@L["Points.Max", Draft.Exercise.MaxPoints]</span></h2>
        @if (Draft.Exercise.Hint is { } hint)
        {
            <p class="hint">@hint</p>
        }
        <Picture Image="@Draft.Exercise.Image" />
    }

    @switch (Draft.Exercise)
    {
        case ClozeSheetDto cloze:
            <p class="cloze">
                @for (var i = 0; i < cloze.Segments.Count; i++)
                {
                    var index = i;
                    @cloze.Segments[index]
                    @if (index < cloze.Segments.Count - 1)
                    {
                        @if (cloze.WordBank is { } words)
                        {
                            <select class="gap" aria-label="@L["Exercise.Gap", index + 1]" value="@Draft.Texts[index]" @onchange="e => Set(index, e)">
                                <option value="">…</option>
                                @foreach (var word in words)
                                {
                                    <option value="@word">@word</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="gap" aria-label="@L["Exercise.Gap", index + 1]" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                                   value="@Draft.Texts[index]" @oninput="e => Set(index, e)" />
                        }
                    }
                }
            </p>
            break;

        case MatchingSheetDto matching:
            <ul class="rows">
                @foreach (var row in matching.Rows)
                {
                    var index = row.Index;
                    <li>
                        <Picture Image="@row.Image" />
                        <span>@row.Text</span>
                        <select aria-label="@L["Exercise.Answer"]" value="@Draft.Texts[index]" @onchange="e => Set(index, e)">
                            <option value="">…</option>
                            @foreach (var option in matching.Options)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </li>
                }
            </ul>
            break;

        case OrderingSheetDto ordering:
            <ol class="steps">
                @foreach (var step in ordering.Steps)
                {
                    var index = step.Index;
                    var position = Draft.Order.IndexOf(index);
                    <li>
                        <button type="button" class="step @(position >= 0 ? "set" : "")" @onclick="() => Toggle(index)">
                            <span class="badge">@(position >= 0 ? position + 1 : "")</span>
                            @step.Text
                        </button>
                    </li>
                }
            </ol>
            <button type="button" class="btn quiet" lang="@UiLanguage.Current" @onclick="Draft.Order.Clear">@L["Exercise.StartOver"]</button>
            break;

        case TrueFalseSheetDto trueFalse:
            <ul class="statements">
                @foreach (var statement in trueFalse.Statements)
                {
                    var index = statement.Index;
                    <li>
                        <Picture Image="@statement.Image" />
                        <span>@statement.Text</span>
                        <span class="choice" lang="@UiLanguage.Current">
                            <button type="button" class="@(Draft.Truths[index] == true ? "on" : "")" aria-pressed="@(Draft.Truths[index] == true)"
                                    @onclick="() => Draft.Truths[index] = true">@L["Answer.True"]</button>
                            <button type="button" class="@(Draft.Truths[index] == false ? "on" : "")" aria-pressed="@(Draft.Truths[index] == false)"
                                    @onclick="() => Draft.Truths[index] = false">@L["Answer.False"]</button>
                        </span>
                    </li>
                }
            </ul>
            break;

        case VocabularySheetDto vocabulary:
            <ol class="fields vocab-questions">
                @foreach (var question in vocabulary.Questions)
                {
                    var index = question.Index;
                    var answerLanguage = question.AsksWord ? vocabulary.WordLanguage : vocabulary.TranslationLanguage;
                    var promptLanguage = question.AsksWord ? vocabulary.TranslationLanguage : vocabulary.WordLanguage;
                    <li @key="index">
                        <Picture Image="@question.Image" Zoom="false" />
                        <label>
                            <span>
                                <span lang="@promptLanguage">@question.Prompt</span>
                                <small class="vocab-to" lang="@UiLanguage.Current">→ @answerLanguage.ToUpperInvariant()</small>
                            </span>
                            <input lang="@answerLanguage" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" value="@Draft.Texts[index]" @oninput="e => Set(index, e)" />
                        </label>
                        @if (!question.AsksWord)
                        {
                            <SpeakButton Text="@question.Prompt" Language="@vocabulary.WordLanguage" />
                        }
                    </li>
                }
            </ol>
            break;
        case FreeTextSheetDto freeText:
            <ol class="fields">
                @for (var i = 0; i < freeText.FieldLabels.Count; i++)
                {
                    var index = i;
                    <li>
                        <label>
                            @if (freeText.FieldLabels[index] is { } label)
                            {
                                <span>@label</span>
                            }
                            <input autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" value="@Draft.Texts[index]" @oninput="e => Set(index, e)" />
                        </label>
                    </li>
                }
            </ol>
            break;

        case MultipleChoiceSheetDto choice:
            @foreach (var question in choice.Questions)
            {
                var questionIndex = question.Index;
                var pictures = question.Options.Any(o => o.Image is not null);
                <fieldset class="question">
                    <legend>@question.Text @if (question.MultipleAnswers) { <span lang="@UiLanguage.Current">@L["Exercise.SeveralCorrect"]</span> }</legend>
                    <Picture Image="@question.Image" />
                    <div class="@(pictures ? "options pictures" : "options")">
                        @foreach (var option in question.Options)
                        {
                            var optionIndex = option.Index;
                            var selected = Draft.Choices[questionIndex].Contains(optionIndex);
                            <button type="button" class="option @(selected ? "on" : "")" aria-pressed="@selected" @onclick="() => Select(questionIndex, optionIndex, question.MultipleAnswers)">
                                <Picture Image="@option.Image" Zoom="false" />
                                @option.Text
                            </button>
                        }
                    </div>
                </fieldset>
            }
            break;

        case WordSearchSheetDto wordSearch:
            var size = wordSearch.Rows.Count;
            <p class="hint" lang="@UiLanguage.Current">@L["Exercise.WordSearchHow"]</p>
            <div class="letter-board size-@size">
                @* Marker lines behind the letters: one cell is one unit, so a cell's centre is (column + 0.5, row + 0.5) *@
                <svg class="found-marks" viewBox="0 0 @size @size" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var (word, line) in Draft.Found)
                    {
                        <g class="mark color-@(word % 6)">
                            <line class="edge" x1="@X(line[0])" y1="@Y(line[0])" x2="@X(line[^1])" y2="@Y(line[^1])" />
                            <line class="fill" x1="@X(line[0])" y1="@Y(line[0])" x2="@X(line[^1])" y2="@Y(line[^1])" />
                        </g>
                    }
                    @if (Draft.Missed is { } miss)
                    {
                        <g class="mark miss">
                            <line class="edge" x1="@X(miss[0])" y1="@Y(miss[0])" x2="@X(miss[^1])" y2="@Y(miss[^1])" />
                            <line class="fill" x1="@X(miss[0])" y1="@Y(miss[0])" x2="@X(miss[^1])" y2="@Y(miss[^1])" />
                        </g>
                    }
                    @if (Draft.Start is { } first)
                    {
                        <circle class="start" cx="@X(first)" cy="@Y(first)" r="0.42" />
                    }
                </svg>
                @* The page CSP forbids inline styles, so the size is a class *@
                <div class="letter-grid size-@size">
                    @for (var r = 0; r < wordSearch.Rows.Count; r++)
                    {
                        @for (var c = 0; c < wordSearch.Rows[r].Length; c++)
                        {
                            var cell = new Cell(r, c);
                            var letter = wordSearch.Rows[r][c];
                            var start = Draft.Start == cell;
                            <button type="button" class="letter @(start ? "start" : "")"
                                    aria-pressed="@start" aria-label="@L["Exercise.Letter", letter, r + 1, c + 1]" @onclick="() => Tap(wordSearch, cell)">@letter</button>
                        }
                    }
                </div>
            </div>
            <p class="found-count" lang="@UiLanguage.Current" aria-live="polite">@L["Exercise.WordsFound", Draft.Found.Count, wordSearch.Words.Count]</p>
            <ul class="words">
                @foreach (var word in wordSearch.Words)
                {
                    var found = Draft.Found.ContainsKey(word.Index);
                    <li class="@(found ? "found" : "")"><span aria-hidden="true">@(found ? "✓" : "○")</span> @word.Text</li>
                }
            </ul>
            <button type="button" class="btn quiet" lang="@UiLanguage.Current" @onclick="ClearWordSearch">@L["Exercise.StartOver"]</button>
            break;

        case FallingWordsSheetDto:
            <FallingWordsGame Draft="@Draft" />
            break;
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required AnswerDraft Draft { get; set; }

    /// <summary>Language of the quiz content (BCP 47).</summary>
    [Parameter]
    public string? Language { get; set; }

    /// <summary>A game made from a lesson: no instruction and no points, the page says what to do.</summary>
    [Parameter]
    public bool Game { get; set; }

    private void Set(int index, ChangeEventArgs e) => Draft.Texts[index] = e.Value?.ToString();

    private void Toggle(int index)
    {
        if (!Draft.Order.Remove(index))
        {
            Draft.Order.Add(index);
        }
    }

    private void Tap(WordSearchSheetDto sheet, Cell cell)
    {
        Draft.Missed = null;
        if (Draft.Start is not { } start || start == cell)
        {
            // A first tap, or the same letter again to take it back
            Draft.Start = Draft.Start is null ? cell : null;
            return;
        }

        if (WordSearch.Line(start, cell) is not { } line)
        {
            // Not in a straight line: start again from this letter
            Draft.Start = cell;
            return;
        }

        Draft.Start = null;
        if (WordSearch.Find(sheet.Rows, line, sheet.Words, Draft.Found.Keys) is { } word)
        {
            Draft.Found[word.Index] = line;
            Draft.Texts[word.Index] = word.Text;
        }
        else
        {
            Draft.Missed = line;
        }
    }

    private static string X(Cell cell) => (cell.Column + 0.5).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string Y(Cell cell) => (cell.Row + 0.5).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private void ClearWordSearch()
    {
        Draft.Found.Clear();
        Array.Clear(Draft.Texts);
        Draft.Start = null;
        Draft.Missed = null;
    }

    private void Select(int question, int option, bool multiple)
    {
        var choices = Draft.Choices[question];
        if (multiple)
        {
            if (!choices.Remove(option))
            {
                choices.Add(option);
            }
        }
        else
        {
            choices.Clear();
            choices.Add(option);
        }
    }
}
