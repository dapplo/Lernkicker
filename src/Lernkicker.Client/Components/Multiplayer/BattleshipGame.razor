@inject Api Api
@inject Sounds Sounds

@* Battleship ("Schiffe versenken"): first each player places the fleet on their own sea, then they take turns
   shooting at the other sea. The server keeps the other fleet secret and checks every move; placing is also checked
   here, so a child sees at once when a ship does not fit.
   Each sea is three layers: the water with its waves, the ships seen from the side (ShipArt), and on top the cells a
   child taps, which also show splashes, fire and blasts. The text that changes from move to move sits in a bar of
   fixed height (two lines) above the seas, so the boards never move. *@

<div class="battleship">
    <p class="battleship-bar @BarTone" role="status" aria-live="polite">@BarText</p>

    @if (Placing)
    {
        <p class="game-how">@L["Battleship.HowToPlace"]</p>
        <div class="sea-frame placing">
            <div class="sea-ships" aria-hidden="true">
                @foreach (var ship in _placed)
                {
                    <div class="@ShipCss(ship)" @key="ship"><ShipArt Length="@ship.Length" Horizontal="@ship.Horizontal" /></div>
                }
            </div>
            <div class="sea" role="grid" aria-label="@L["Battleship.MySea"]">
                @for (var y = 0; y < View.Size; y++)
                {
                    for (var x = 0; x < View.Size; x++)
                    {
                        var (cx, cy) = (x, y);
                        var ship = _placed.Any(s => Covers(s, cx, cy));
                        <button type="button" class="cell @(ship ? "ship" : "")" aria-label="@(ship ? $"{Coordinate(cx, cy)}, {L["Battleship.Ship"]}" : Coordinate(cx, cy))"
                                disabled="@Busy" @onclick="() => Place(cx, cy)"></button>
                    }
                }
            </div>
        </div>
        <div class="buttons">
            <button class="btn quiet" type="button" @onclick="() => _horizontal = !_horizontal">
                <span aria-hidden="true">@(_horizontal ? "↔" : "↕")</span> @(_horizontal ? L["Battleship.Across"] : L["Battleship.Down"])
            </button>
            <button class="btn quiet" type="button" disabled="@Busy" @onclick="Mix"><span aria-hidden="true">🔀</span> @L["Battleship.Mix"]</button>
            <button class="btn quiet" type="button" disabled="@(_placed.Count == 0)" @onclick="Clear">@L["Battleship.Clear"]</button>
            <button class="btn" type="button" disabled="@(Busy || Next is not null)" @onclick="Ready">@L["Battleship.Ready"]</button>
            @SoundToggle
        </div>
    }
    else
    {
        <div class="seas">
            @if (View.Phase != "placing")
            {
                var lastShot = View.MyShots.Count > 0 ? View.MyShots[^1] : null;
                <section class="sea-box @(MyTurn ? "my-turn" : "")">
                    <h2>@L["Battleship.TheirSea", Opponent]</h2>
                    <div class="sea-frame">
                        <div class="sea-ships" aria-hidden="true">
                            @foreach (var ship in View.SunkShips)
                            {
                                @* Once the game is over the ships nobody found show as well *@
                                var css = Sunk(ship, View.MyShots) ? Sinking(ship, lastShot) : "revealed";
                                <div class="@ShipCss(ship) @css" @key="ship"><ShipArt Length="@ship.Length" Horizontal="@ship.Horizontal" /></div>
                            }
                        </div>
                        <div class="sea" role="grid" aria-label="@L["Battleship.TheirSea", Opponent]">
                            @for (var y = 0; y < View.Size; y++)
                            {
                                for (var x = 0; x < View.Size; x++)
                                {
                                    var (cx, cy) = (x, y);
                                    var shot = View.MyShots.FirstOrDefault(s => s.X == cx && s.Y == cy);
                                    var sunk = View.SunkShips.Any(s => Covers(s, cx, cy) && Sunk(s, View.MyShots));
                                    <button type="button" class="cell @CellCss(shot, sunk, shot is not null && shot == lastShot)" aria-label="@CellLabel(cx, cy, shot, sunk)"
                                            disabled="@(Busy || !MyTurn || shot is not null)" @onclick="() => Shoot(cx, cy)">@Effects(shot, sunk, shot is not null && shot == lastShot)</button>
                                }
                            }
                        </div>
                    </div>
                    <p class="fleet-left">@L["Battleship.FleetLeft"] @Fleet(View.SunkShips.Where(s => Sunk(s, View.MyShots)))</p>
                </section>
            }
            @{
                var theirLast = View.TheirShots.Count > 0 ? View.TheirShots[^1] : null;
                var myShips = View.MyShips ?? [];
            }
            <section class="sea-box">
                <h2>@L["Battleship.MySea"]</h2>
                <div class="sea-frame mine">
                    <div class="sea-ships" aria-hidden="true">
                        @foreach (var ship in myShips)
                        {
                            var css = Sunk(ship, View.TheirShots) ? Sinking(ship, theirLast) : "";
                            <div class="@ShipCss(ship) @css" @key="ship"><ShipArt Length="@ship.Length" Horizontal="@ship.Horizontal" /></div>
                        }
                    </div>
                    <div class="sea" role="grid" aria-label="@L["Battleship.MySea"]">
                        @for (var y = 0; y < View.Size; y++)
                        {
                            for (var x = 0; x < View.Size; x++)
                            {
                                var (cx, cy) = (x, y);
                                var shot = View.TheirShots.FirstOrDefault(s => s.X == cx && s.Y == cy);
                                var ship = myShips.FirstOrDefault(s => Covers(s, cx, cy));
                                var sunk = ship is not null && Sunk(ship, View.TheirShots);
                                <span class="cell @CellCss(shot, sunk, shot is not null && shot == theirLast)" role="gridcell" aria-label="@CellLabel(cx, cy, shot, sunk)">@Effects(shot, sunk, shot is not null && shot == theirLast)</span>
                            }
                        }
                    </div>
                </div>
                <p class="fleet-left">@L["Battleship.MyFleetLeft"] @Fleet(myShips.Where(s => Sunk(s, View.TheirShots)))</p>
            </section>
        </div>
        <div class="buttons">@SoundToggle</div>
    }
</div>

@code {
    private List<ShipDto> _placed = [];
    private bool _horizontal = true;
    private string? _hint;
    private bool _soundOn = true;

    // What the last view showed, to find out what the new one brings (and which sound goes with it)
    private BattleshipViewDto? _seen;

    [Parameter, EditorRequired]
    public required BattleshipViewDto View { get; set; }

    [Parameter]
    public int MySeat { get; set; }

    [Parameter]
    public string Opponent { get; set; } = "";

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<MoveDto> Move { get; set; }

    private bool Placing => View.Phase == "placing" && View.MyShips is null;

    private bool MyTurn => View.Phase == "shooting" && View.Turn == MySeat;

    protected override async Task OnInitializedAsync() => _soundOn = await Sounds.IsOn();

    protected override async Task OnParametersSetAsync()
    {
        var before = _seen;
        _seen = View;
        if (before is not null && !ReferenceEquals(before, View))
        {
            await PlayNews(before);
        }
    }

    /// <summary>The sound for the newest shot on either sea, and a tune when a fleet is gone.</summary>
    private async Task PlayNews(BattleshipViewDto before)
    {
        if (View.MyShots.Count > before.MyShots.Count)
        {
            var shot = View.MyShots[^1];
            var sunk = View.SunkShips.Count(s => Sunk(s, View.MyShots)) > before.SunkShips.Count(s => Sunk(s, before.MyShots));
            await Sounds.Play(Steps(shot, sunk, won: View.Phase == "over" && sunk));
        }
        else if (View.TheirShots.Count > before.TheirShots.Count && View.MyShips is { } mine)
        {
            var shot = View.TheirShots[^1];
            var sunk = mine.Count(s => Sunk(s, View.TheirShots)) > mine.Count(s => Sunk(s, before.TheirShots));
            var lost = mine.All(s => Sunk(s, View.TheirShots));
            await Sounds.Play(Steps(shot, sunk, won: false, lost));
        }
    }

    private static (string, double)[] Steps(ShotDto shot, bool sunk, bool won, bool lost = false)
    {
        List<(string, double)> steps = [shot.Hit ? ("hit", 0) : ("splash", 0)];
        if (sunk)
        {
            steps.Add(("sink", 0.7));
        }

        if (won || lost)
        {
            steps.Add((won ? "win" : "lose", 2.6));
        }

        return [.. steps];
    }

    private RenderFragment SoundToggle => @<button type="button" class="btn quiet sound-toggle" aria-pressed="@(_soundOn ? "true" : "false")" @onclick="ToggleSound">
        <span aria-hidden="true">@(_soundOn ? "🔊" : "🔇")</span> @(_soundOn ? L["Sound.On"] : L["Sound.Off"])
    </button>;

    private async Task ToggleSound()
    {
        await Sounds.Toggle();
        _soundOn = await Sounds.IsOn();
    }

    /// <summary>The line above the seas: what to do now, or what just happened. It always has room for two lines.</summary>
    private string BarText
    {
        get
        {
            if (_hint is { } hint)
            {
                return hint;
            }

            if (Placing)
            {
                return Next is { } next ? L["Battleship.PlaceNext", ShipName(next)] : L["Battleship.AllPlaced"];
            }

            if (View.Phase == "placing")
            {
                return L["Battleship.WaitingForFleet", Opponent];
            }

            if (View.Phase != "shooting")
            {
                return "";
            }

            if (MyTurn)
            {
                if (View.MyShots.Count > 0 && View.MyShots[^1] is { Hit: true } mine)
                {
                    var sunk = View.SunkShips.FirstOrDefault(s => Covers(s, mine.X, mine.Y) && Sunk(s, View.MyShots));
                    return sunk is null ? L["Battleship.HitAgain"] : L["Battleship.SunkAgain", ShipName(sunk.Length)];
                }

                return L["Battleship.Shoot", Opponent];
            }

            if (View.TheirShots.Count > 0 && View.TheirShots[^1] is { Hit: true })
            {
                return L["Battleship.TheyHit", Opponent];
            }

            return View.MyShots.Count > 0 ? L["Battleship.MissThenThey", Opponent] : L["Battleship.TheyShoot", Opponent];
        }
    }

    private string BarTone => _hint is not null ? "warn" : MyTurn || Placing ? "go" : "";

    /// <summary>The next ship to place: the fleet in order, minus what is on the sea already.</summary>
    private int? Next
    {
        get
        {
            var left = View.Fleet.ToList();
            foreach (var ship in _placed)
            {
                left.Remove(ship.Length);
            }

            return left.Count > 0 ? left[0] : null;
        }
    }

    /// <summary>Where a ship lies on the grid: first column/row and its length (classes, since inline styles are blocked).</summary>
    private static string ShipCss(ShipDto ship) =>
        $"ship-art {(ship.Horizontal ? "h" : "v")} c-{ship.X} r-{ship.Y} s-{Math.Clamp(ship.Length, 2, 5)}";

    /// <summary>A sunk ship lies under water; it only goes down before the eyes when the last shot sank it.</summary>
    private static string Sinking(ShipDto ship, ShotDto? last) =>
        last is not null && Covers(ship, last.X, last.Y) ? "sunk sinking" : "sunk";

    private static string CellCss(ShotDto? shot, bool sunk, bool last) =>
        (shot is null ? "" : sunk ? "sunk" : shot.Hit ? "hit" : "miss") + (last ? " last" : "");

    /// <summary>
    /// What a shot left behind: rings on the water for a miss, fire and smoke for a hit. The last shot also shows its
    /// splash or blast, which plays once.
    /// </summary>
    private static RenderFragment Effects(ShotDto? shot, bool sunk, bool last) => builder =>
    {
        if (shot is null)
        {
            return;
        }

        var seq = 0;
        void Span(string css, int drops = 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", $"fx {css}");
            builder.AddAttribute(seq++, "aria-hidden", "true");
            for (var i = 0; i < drops; i++)
            {
                builder.OpenElement(seq++, "i");
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        if (!shot.Hit)
        {
            Span("ripple");
            if (last)
            {
                Span("splash", 5);
            }

            return;
        }

        if (!sunk)
        {
            Span("debris");
            Span("smoke", 2);
            Span("fire", 2);
        }

        if (last)
        {
            Span("boom", 6);
        }
    };

    private static bool Covers(ShipDto ship, int x, int y) =>
        ship.Horizontal ? y == ship.Y && x >= ship.X && x < ship.X + ship.Length : x == ship.X && y >= ship.Y && y < ship.Y + ship.Length;

    private static IEnumerable<(int X, int Y)> Cells(ShipDto ship) =>
        Enumerable.Range(0, ship.Length).Select(i => ship.Horizontal ? (ship.X + i, ship.Y) : (ship.X, ship.Y + i));

    private static bool Sunk(ShipDto ship, IReadOnlyList<ShotDto> shots) =>
        Cells(ship).All(c => shots.Any(s => s.X == c.X && s.Y == c.Y));

    /// <summary>Like the server's rule: on the sea, and no other ship around it, not even at a corner.</summary>
    private bool Fits(ShipDto ship) =>
        Cells(ship).All(c => c.X >= 0 && c.X < View.Size && c.Y >= 0 && c.Y < View.Size)
        && _placed.All(other => Cells(other).All(o => Cells(ship).All(c => Math.Abs(c.X - o.X) > 1 || Math.Abs(c.Y - o.Y) > 1)));

    private static string Coordinate(int x, int y) => $"{(char)('A' + x)}{y + 1}";

    private string CellLabel(int x, int y, ShotDto? shot, bool sunk) =>
        Coordinate(x, y) + (sunk ? ", " + L["Battleship.Sunk"] : shot is null ? "" : shot.Hit ? ", " + L["Battleship.Hit"] : ", " + L["Battleship.Miss"]);

    private string ShipName(int length) => L[$"Battleship.Ship{length}"];

    /// <summary>The fleet as little ships, the sunk ones faded and crossed out.</summary>
    private RenderFragment Fleet(IEnumerable<ShipDto> sunk) => builder =>
    {
        var gone = sunk.Select(s => s.Length).ToList();
        var seq = 0;
        foreach (var length in View.Fleet)
        {
            var isGone = gone.Remove(length);
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", $"fleet-ship s-{Math.Clamp(length, 2, 5)}{(isGone ? " gone" : "")}");
            builder.AddAttribute(seq++, "title", ShipName(length));
            builder.AddAttribute(seq++, "role", "img");
            builder.AddAttribute(seq++, "aria-label", isGone ? $"{ShipName(length)}, {L["Battleship.Sunk"]}" : ShipName(length));
            builder.OpenComponent<ShipArt>(seq++);
            builder.AddAttribute(seq++, nameof(ShipArt.Length), length);
            builder.CloseComponent();
            builder.CloseElement();
        }
    };

    private async Task Place(int x, int y)
    {
        _hint = null;
        var hit = _placed.FirstOrDefault(s => Covers(s, x, y));
        if (hit is not null)
        {
            _placed.Remove(hit);
            return;
        }

        if (Next is not { } length)
        {
            return;
        }

        var ship = new ShipDto(x, y, length, _horizontal);
        if (Fits(ship))
        {
            _placed.Add(ship);
            await Sounds.Play(("place", 0));
        }
        else
        {
            _hint = L["Battleship.DoesNotFit"];
        }
    }

    private void Clear()
    {
        _placed = [];
        _hint = null;
    }

    private async Task Mix()
    {
        _hint = null;
        _placed = await Api.RandomFleet();
        await Sounds.Play(("place", 0));
    }

    private Task Ready() => Move.InvokeAsync(new BattleshipPlaceDto(_placed));

    private async Task Shoot(int x, int y)
    {
        await Sounds.Play(("shot", 0));
        await Move.InvokeAsync(new BattleshipShootDto(x, y));
    }
}
