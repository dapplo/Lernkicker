@inject IJSRuntime Js
@* The result of a handed-in quiz: score, stars and per exercise what was right and what the solution is.
   Exercises with mistakes are listed at the top to jump to, or the list can be cut down to them. *@

<section class="result" lang="@Language">
    <div class="stars big" aria-label="@L["Stars.Label", StarCount]">@Display.Stars(StarCount)</div>
    <p class="total" lang="@UiLanguage.Current">@(Result.Mark is { } mark ? L["Result.Total", Result.Points, Result.MaxPoints, mark] : L["Result.TotalWithoutMark", Result.Points, Result.MaxPoints])</p>
    @if (ShowPraise)
    {
        <p class="praise" lang="@UiLanguage.Current">@Display.Praise(Result.Percent)</p>
    }

    @if (Mistakes.Count > 0)
    {
        <nav class="mistakes" lang="@UiLanguage.Current" aria-label="@L["Result.Mistakes"]">
            <span>@L["Result.Mistakes"]</span>
            @foreach (var number in Mistakes)
            {
                <button type="button" aria-label="@L["Result.JumpTo", number]" @onclick="() => JumpTo(number)">@number</button>
            }
            <button type="button" class="filter" aria-pressed="@(_onlyMistakes ? "true" : "false")" @onclick="() => _onlyMistakes = !_onlyMistakes">
                @(_onlyMistakes ? L["Result.ShowAll"] : L["Result.OnlyMistakes"])
            </button>
        </nav>
    }

    @for (var i = 0; i < Result.Exercises.Count; i++)
    {
        var exercise = Result.Exercises[i];
        var number = i + 1;
        var full = exercise.Points == exercise.MaxPoints;
        if (full && _onlyMistakes)
        {
            continue;
        }
        <article class="exercise-result @(full ? "full" : "")" id="@Anchor(number)" @key="exercise.Id">
            <h3><span class="number">@number.</span> @exercise.Instruction <span class="points" lang="@UiLanguage.Current">@L["Points.Of", exercise.Points, exercise.MaxPoints]</span></h3>
            <ul>
                @foreach (var part in exercise.Parts)
                {
                    var solution = Solution(exercise, part);
                    <li class="@(part.Correct ? "ok" : "wrong")">
                        <span aria-hidden="true">@(part.Correct ? "✓" : "✗")</span>
                        @if (part.Correct)
                        {
                            <span>@solution</span>
                        }
                        else
                        {
                            <span><span lang="@UiLanguage.Current">@L["Result.CorrectWouldBe"]</span> <b>@solution</b></span>
                        }
                        @if (!part.Correct && part.Explanation is { } explanation)
                        {
                            <small>@explanation</small>
                        }
                    </li>
                }
            </ul>
            @if (exercise.Explanation is { } takeaway)
            {
                <p class="takeaway">💡 @takeaway</p>
            }
        </article>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required QuizResultDto Result { get; set; }

    /// <summary>Language of the quiz content (BCP 47).</summary>
    [Parameter]
    public string? Language { get; set; }

    [Parameter]
    public bool ShowPraise { get; set; } = true;

    private bool _onlyMistakes;

    /// <summary>Numbers (from 1) of the exercises that did not get full points.</summary>
    private List<int> Mistakes => Result.Exercises
        .Select((exercise, index) => (exercise, number: index + 1))
        .Where(e => e.exercise.Points < e.exercise.MaxPoints)
        .Select(e => e.number)
        .ToList();

    private static string Anchor(int number) => $"result-{number}";

    private ValueTask JumpTo(int number) => Js.InvokeVoidAsync("lernkicker.scrollToId", Anchor(number));

    // Same thresholds as the server's stars (50 / 70 / 90 %)
    private int StarCount => Result.Percent switch { >= 90 => 3, >= 70 => 2, >= 50 => 1, _ => 0 };

    private string Solution(ExerciseResultDto exercise, PartResultDto part) => exercise.Type switch
    {
        "trueFalse" => part.ExpectedTruth == true ? L["Answer.True"] : L["Answer.False"],
        "ordering" => $"{part.Index + 1}. {part.Solution}",
        _ => part.Solution ?? "",
    };
}
