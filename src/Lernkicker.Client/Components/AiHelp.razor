@* How to have an AI assistant write a quiz or lesson: the prompt (with both schemas) and the schemas themselves *@

<details class="ai-help">
    <summary>@L["AiHelp.Title"]</summary>
    <ol class="hint">
        <li>@L["AiHelp.Step1"]</li>
        <li>@L["AiHelp.Step2"]</li>
        <li>@L["AiHelp.Step3"]</li>
    </ol>
    <p><a class="btn" href="api/format/ai-prompt?lang=@UiLanguage.Current" download>@L["AiHelp.Prompt"]</a></p>
    <p class="hint">
        @L["AiHelp.Schemas"]
        <a href="api/format/quiz-v1.schema.json" download>quiz-v1.schema.json</a>,
        <a href="api/format/lesson-v1.schema.json" download>lesson-v1.schema.json</a>
    </p>
</details>
