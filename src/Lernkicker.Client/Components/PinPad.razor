@* A big number pad for the child's 4-digit PIN. *@

<div class="pin-pad">
    <div class="pin-dots" aria-label="@L["Pin.Entered", _pin.Length]">
        @for (var i = 0; i < 4; i++)
        {
            <span class="pin-dot @(i < _pin.Length ? "full" : "")"></span>
        }
    </div>
    @if (Error is { } error)
    {
        <p class="error" role="alert">@error</p>
    }
    <div class="keys">
        @foreach (var digit in "123456789")
        {
            var d = digit;
            <button type="button" disabled="@Disabled" @onclick="() => Tap(d)">@d</button>
        }
        <span></span>
        <button type="button" disabled="@Disabled" @onclick="@(() => Tap('0'))">0</button>
        <button type="button" disabled="@Disabled" aria-label="@L["Pin.Delete"]" @onclick="Delete">⌫</button>
    </div>
</div>

@code {
    private string _pin = "";

    [Parameter, EditorRequired]
    public EventCallback<string> Entered { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private async Task Tap(char digit)
    {
        if (_pin.Length >= 4)
        {
            return;
        }

        _pin += digit;
        if (_pin.Length == 4)
        {
            var pin = _pin;
            _pin = "";
            await Entered.InvokeAsync(pin);
        }
    }

    private void Delete() => _pin = _pin.Length > 0 ? _pin[..^1] : "";
}
