@inject Speech Speech
@* Reads a word aloud in its language; shown whenever the browser can speak (the device picks the voice) *@
@if (_hasVoice)
{
    <button type="button" class="speak" aria-label="@L["Vocabulary.Speak", Text]" @onclick="() => Speech.Speak(Text, Language)">🔊</button>
}

@code {
    private bool _hasVoice;

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>BCP 47 tag of the text, e.g. "nl".</summary>
    [Parameter, EditorRequired]
    public string Language { get; set; } = "";

    protected override async Task OnInitializedAsync() => _hasVoice = await Speech.CanSpeak();
}
