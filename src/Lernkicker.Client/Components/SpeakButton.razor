@inject Speech Speech
@* Reads a word aloud in its language; shown only when the device has a voice for that language *@
@if (_hasVoice)
{
    <button type="button" class="speak" aria-label="@L["Vocabulary.Speak", Text]" @onclick="() => Speech.Speak(Text, Language)">🔊</button>
}

@code {
    private bool _hasVoice;

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>BCP 47 tag of the text, e.g. "nl".</summary>
    [Parameter, EditorRequired]
    public string Language { get; set; } = "";

    protected override async Task OnParametersSetAsync() => _hasVoice = await Speech.HasVoice(Language);
}
