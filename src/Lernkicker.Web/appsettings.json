{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lernkicker": {
    "DataPath": "data",
    "Limits": {
      "LoginsPerMinute": 10,
      "ChildLoginsPerMinute": 20
    }
