<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Driving adapter (HTTP API, cookies) and composition root: wires the use cases to the other adapters -->

  <PropertyGroup>
    <UserSecretsId>lernkicker-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lernkicker.Application\Lernkicker.Application.csproj" />
    <ProjectReference Include="..\Lernkicker.Calendar\Lernkicker.Calendar.csproj" />
    <ProjectReference Include="..\Lernkicker.Client\Lernkicker.Client.csproj" />
    <ProjectReference Include="..\Lernkicker.Contracts\Lernkicker.Contracts.csproj" />
    <ProjectReference Include="..\Lernkicker.Persistence\Lernkicker.Persistence.csproj" />
    <ProjectReference Include="..\Lernkicker.QuizFormat\Lernkicker.QuizFormat.csproj" />
    <ProjectReference Include="..\Lernkicker.Telegram\Lernkicker.Telegram.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served to parents for their AI assistants (FormatEndpoints) -->
    <EmbeddedResource Include="..\..\schema\quiz-v1.schema.json" LogicalName="format/quiz-v1.schema.json" />
    <EmbeddedResource Include="..\..\schema\lesson-v1.schema.json" LogicalName="format/lesson-v1.schema.json" />
    <EmbeddedResource Include="..\..\docs\ai-prompt\en.md" LogicalName="format/ai-prompt.en.md" />
    <EmbeddedResource Include="..\..\docs\ai-prompt\de.md" LogicalName="format/ai-prompt.de.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

</Project>
