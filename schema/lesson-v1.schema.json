{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dapplo/lernkicker/main/schema/lesson-v1.schema.json",
  "title": "Lernkicker learning material (lesson/v1)",
  "description": "Learning material for Lernkicker: text, a poem to learn by heart, flashcards, key facts, or a guide to look things up in. See docs/lesson-format.md.",
  "type": "object",
  "required": ["format", "id", "title", "subject", "gradeLevel", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "lesson/v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Unique within a family. Uploading the same id again replaces the lesson."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subject": {
      "enum": ["science", "german", "math", "english", "religion", "ethics", "music", "art", "sports", "crafts", "other"],
      "description": "School subject. 'science' is the Bavarian HSU (Heimat- und Sachunterricht)."
    },
    "gradeLevel": { "type": "integer", "minimum": 1, "maximum": 13, "description": "School year (Jahrgangsstufe)." },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "default": "de",
      "description": "Language of the content as a BCP 47 tag, e.g. 'de' or 'en'."
    },
    "topic": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "source": { "type": "string", "maxLength": 200, "description": "Where the material comes from, e.g. a worksheet." },
    "mode": {
      "enum": ["learn", "reference"],
      "default": "learn",
      "description": "'learn': the child marks each part as known. 'reference': something to look things up in (e.g. the rules of a game): no 'I know this' marks, a list of the parts at the top to jump to."
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "line": { "type": "string", "minLength": 1, "maxLength": 300 },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "type": { "enum": ["text", "poem", "flashcards", "facts", "image", "entries"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "$ref": "#/$defs/text" } },
        { "if": { "properties": { "type": { "const": "poem" } } }, "then": { "$ref": "#/$defs/poem" } },
        { "if": { "properties": { "type": { "const": "flashcards" } } }, "then": { "$ref": "#/$defs/flashcards" } },
        { "if": { "properties": { "type": { "const": "facts" } } }, "then": { "$ref": "#/$defs/facts" } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "$ref": "#/$defs/imageBlock" } },
        { "if": { "properties": { "type": { "const": "entries" } } }, "then": { "$ref": "#/$defs/entries" } }
      ]
    },
    "blockId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 },
    "blockTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
    "text": {
      "description": "Text to read. Paragraphs are separated by an empty line; **bold**, *italic* and lines starting with '- ' (lists) are formatted.",
      "required": ["id", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": true,
        "title": { "$ref": "#/$defs/blockTitle" },
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "image": { "$ref": "#/$defs/image", "description": "A picture shown above the text." }
      }
    },
    "poem": {
      "description": "A poem (or any text) to learn by heart. Each stanza is a list of lines. The app offers reading, practising with words hidden step by step, and reciting.",
      "required": ["id", "type", "stanzas"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": true,
        "title": { "$ref": "#/$defs/blockTitle" },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "stanzas": {
          "type": "array", "minItems": 1, "maxItems": 40,
          "items": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/line" } }
        },
        "hint": { "type": "string", "minLength": 1, "maxLength": 500, "description": "E.g. 'Lies jede Strophe dreimal laut.'" }
      }
    },
    "flashcards": {
      "description": "Cards with a question or word on the front and the answer on the back. The child flips them and sorts out the ones they know.",
      "required": ["id", "type", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": true,
        "title": { "$ref": "#/$defs/blockTitle" },
        "cards": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["front", "back"],
            "additionalProperties": false,
            "properties": {
              "front": { "$ref": "#/$defs/line" },
              "back": { "$ref": "#/$defs/line" },
              "frontImage": { "$ref": "#/$defs/image", "description": "A picture on the front, above the text." },
              "backImage": { "$ref": "#/$defs/image", "description": "A picture on the back, above the text." }
            }
          }
        }
      }
    },
    "facts": {
      "description": "Short key facts to remember, shown as a highlighted list.",
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": true,
        "title": { "$ref": "#/$defs/blockTitle" },
        "items": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/line" } },
        "image": { "$ref": "#/$defs/image", "description": "A picture shown above the facts." }
      }
    },
    "entries": {
      "description": "Things to look up, e.g. what each card of a game does: each entry has a name, a short text and optionally a picture. The app shows them as a compact list with a search field.",
      "required": ["id", "type", "entries"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": true,
        "title": { "$ref": "#/$defs/blockTitle" },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["name", "text"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Same formatting as a text block: paragraphs, '- ' lists, **bold**, *italic*." },
              "image": { "$ref": "#/$defs/image", "description": "A small picture next to the entry." }
            }
          }
        }
      }
    },
    "imageBlock": {
      "description": "A picture on its own, shown large; tap it to see it full screen.",
      "required": ["id", "type", "image"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "type": true,
        "title": { "$ref": "#/$defs/blockTitle" },
        "image": { "$ref": "#/$defs/image" }
      }
    },
    "image": {
      "description": "A picture uploaded together with the JSON. src is the file's path relative to the JSON file; PNG, JPEG, GIF, WebP and SVG are accepted (SVG without scripts or outside links).",
      "type": "object", "required": ["src", "alt"], "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string", "minLength": 1, "maxLength": 200,
          "pattern": "^[A-Za-z0-9ÄÖÜäöüß_-][A-Za-z0-9ÄÖÜäöüß_. -]*(/[A-Za-z0-9ÄÖÜäöüß_-][A-Za-z0-9ÄÖÜäöüß_. -]*)*$",
          "description": "Relative path of the picture file, e.g. 'plants/rose.jpg'. No URLs, no leading '/', no '..'."
        },
        "alt": { "type": "string", "minLength": 1, "maxLength": 200, "description": "What the picture shows, in the content language. Read by screen readers and shown when the picture is missing." },
        "caption": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Text under the picture." },
        "credit": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Source and licence, e.g. 'Wikimedia Commons, CC0'." }
      }
    }
  }
}
