{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dapplo/lernkicker/schema/probe-v1.schema.json",
  "title": "Lernkicker Übungsprobe (probe/v1)",
  "description": "Eine Übungsprobe für Lernkicker. Beschreibung siehe docs/probe-format.md.",
  "type": "object",
  "required": ["format", "id", "titel", "fach", "klasse", "aufgaben"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "probe/v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Eindeutige Kennung innerhalb der Familie. Gleiche id erneut hochladen = neue Version."
    },
    "titel": { "type": "string", "minLength": 1, "maxLength": 120 },
    "fach": {
      "enum": ["HSU", "Deutsch", "Mathematik", "Englisch", "Religion", "Ethik", "Musik", "Kunst", "Sport", "Werken", "Sonstiges"]
    },
    "klasse": { "type": "integer", "minimum": 1, "maximum": 13 },
    "thema": { "type": "string", "maxLength": 120 },
    "beschreibung": { "type": "string", "maxLength": 500 },
    "dauerMinuten": { "type": "integer", "minimum": 1, "maximum": 180 },
    "quelle": { "type": "string", "maxLength": 200, "description": "Woher der Stoff stammt, z. B. Hefteintrag oder Arbeitsblatt." },
    "mischen": { "type": "boolean", "default": true, "description": "Antwortmöglichkeiten und Zeilen bei jeder Runde neu mischen." },
    "aufgaben": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/aufgabe" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "antwortListe": {
      "description": "Alle Schreibweisen, die als richtig gelten. Groß-/Kleinschreibung und Leerzeichen am Rand werden ignoriert.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "basis": {
      "type": "object",
      "required": ["id", "typ", "anweisung"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 },
        "typ": { "type": "string" },
        "anweisung": { "$ref": "#/$defs/text" },
        "hinweis": { "$ref": "#/$defs/text" },
        "punkte": { "type": "integer", "minimum": 1, "maximum": 50, "description": "Höchstpunktzahl. Fehlt sie, gibt jede Lücke, Zeile oder Frage 1 Punkt." },
        "erklaerung": { "$ref": "#/$defs/text", "description": "Wird nach dem Auswerten angezeigt." },
        "loesungstext": { "$ref": "#/$defs/text", "description": "Optionaler Text für 'Lösungen zeigen'. Fehlt er, erzeugt die App ihn." }
      }
    },
    "aufgabe": {
      "type": "object",
      "required": ["typ"],
      "properties": {
        "typ": { "enum": ["luecke", "zuordnen", "reihenfolge", "richtigFalsch", "freitext", "auswahl"] }
      },
      "allOf": [
        { "$ref": "#/$defs/basis" },
        { "if": { "properties": { "typ": { "const": "luecke" } } }, "then": { "$ref": "#/$defs/luecke" } },
        { "if": { "properties": { "typ": { "const": "zuordnen" } } }, "then": { "$ref": "#/$defs/zuordnen" } },
        { "if": { "properties": { "typ": { "const": "reihenfolge" } } }, "then": { "$ref": "#/$defs/reihenfolge" } },
        { "if": { "properties": { "typ": { "const": "richtigFalsch" } } }, "then": { "$ref": "#/$defs/richtigFalsch" } },
        { "if": { "properties": { "typ": { "const": "freitext" } } }, "then": { "$ref": "#/$defs/freitext" } },
        { "if": { "properties": { "typ": { "const": "auswahl" } } }, "then": { "$ref": "#/$defs/auswahl" } }
      ]
    },
    "luecke": {
      "description": "Lückentext. Jedes ___ im text ist eine Lücke; luecken[i] gehört zur i-ten Lücke.",
      "required": ["text", "luecken"],
      "properties": {
        "id": true, "typ": true, "anweisung": true, "hinweis": true, "punkte": true, "erklaerung": true, "loesungstext": true,
        "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "___" },
        "wortspeicher": {
          "description": "Wenn vorhanden: Lücken werden als Auswahlliste mit diesen Wörtern angezeigt. Sonst Eingabefeld.",
          "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "luecken": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["antworten"], "additionalProperties": false, "properties": { "antworten": { "$ref": "#/$defs/antwortListe" } } }
        }
      },
      "additionalProperties": false
    },
    "zuordnen": {
      "description": "Jede Zeile bekommt eine der optionen per Auswahlliste. Optionen dürfen mehrfach passen.",
      "required": ["optionen", "zeilen"],
      "properties": {
        "id": true, "typ": true, "anweisung": true, "hinweis": true, "punkte": true, "erklaerung": true, "loesungstext": true,
        "optionen": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "zeilen": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text", "antwort"], "additionalProperties": false,
            "properties": { "text": { "$ref": "#/$defs/text" }, "antwort": { "type": "string" }, "erklaerung": { "$ref": "#/$defs/text" } }
          }
        }
      },
      "additionalProperties": false
    },
    "reihenfolge": {
      "description": "Schritte in der RICHTIGEN Reihenfolge angeben; die App mischt sie.",
      "required": ["schritte"],
      "properties": {
        "id": true, "typ": true, "anweisung": true, "hinweis": true, "punkte": true, "erklaerung": true, "loesungstext": true,
        "schritte": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      },
      "additionalProperties": false
    },
    "richtigFalsch": {
      "required": ["aussagen"],
      "properties": {
        "id": true, "typ": true, "anweisung": true, "hinweis": true, "punkte": true, "erklaerung": true, "loesungstext": true,
        "aussagen": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text", "richtig"], "additionalProperties": false,
            "properties": { "text": { "$ref": "#/$defs/text" }, "richtig": { "type": "boolean" }, "erklaerung": { "$ref": "#/$defs/text" } }
          }
        }
      },
      "additionalProperties": false
    },
    "freitext": {
      "description": "Eingabefelder. Bei reihenfolgeEgal darf jede richtige Antwort in jedem Feld stehen, aber jede nur einmal zählen.",
      "required": ["felder"],
      "properties": {
        "id": true, "typ": true, "anweisung": true, "hinweis": true, "punkte": true, "erklaerung": true, "loesungstext": true,
        "reihenfolgeEgal": { "type": "boolean", "default": false },
        "felder": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "required": ["antworten"], "additionalProperties": false,
            "properties": { "beschriftung": { "type": "string", "maxLength": 120 }, "antworten": { "$ref": "#/$defs/antwortListe" } }
          }
        }
      },
      "additionalProperties": false
    },
    "auswahl": {
      "description": "Multiple Choice. richtig ist der Index (ab 0) der richtigen Option, oder eine Liste von Indizes bei mehreren richtigen.",
      "required": ["fragen"],
      "properties": {
        "id": true, "typ": true, "anweisung": true, "hinweis": true, "punkte": true, "erklaerung": true, "loesungstext": true,
        "fragen": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["frage", "optionen", "richtig"], "additionalProperties": false,
            "properties": {
              "frage": { "$ref": "#/$defs/text" },
              "optionen": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
              "richtig": {
                "oneOf": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
                ]
              },
              "erklaerung": { "$ref": "#/$defs/text" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
