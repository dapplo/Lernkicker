{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dapplo/lernkicker/main/schema/quiz-v1.schema.json",
  "title": "Lernkicker practice quiz (quiz/v1)",
  "description": "A practice quiz for Lernkicker. See docs/quiz-format.md.",
  "type": "object",
  "required": ["format", "id", "title", "subject", "exercises"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "quiz/v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Unique within a family. Uploading the same id again creates a new version."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subject": {
      "enum": ["science", "german", "math", "english", "religion", "ethics", "music", "art", "sports", "crafts", "other"],
      "description": "School subject. 'science' is the Bavarian HSU (Heimat- und Sachunterricht)."
    },
    "gradeLevel": { "type": "integer", "minimum": 1, "maximum": 13, "description": "School year (Jahrgangsstufe). Leave it out for material for adults (not for a school year)." },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "default": "de",
      "description": "Language of the quiz content as a BCP 47 tag, e.g. 'de' or 'en'."
    },
    "topic": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 180 },
    "source": { "type": "string", "maxLength": 200, "description": "Where the material comes from, e.g. a notebook entry or worksheet." },
    "shuffle": { "type": "boolean", "default": true, "description": "Shuffle options, rows and statements for every round." },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "answerList": {
      "description": "Every spelling that counts as correct. Case and surrounding whitespace are ignored.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "base": {
      "type": "object",
      "required": ["id", "type", "instruction"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 },
        "type": { "type": "string" },
        "instruction": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "points": { "type": "integer", "minimum": 1, "maximum": 50, "description": "Maximum points. Without it, every gap, row or question gives 1 point." },
        "explanation": { "$ref": "#/$defs/text", "description": "Shown after grading." },
        "solutionText": { "$ref": "#/$defs/text", "description": "Optional text for 'show solutions'. Without it, the app builds one." },
        "image": { "$ref": "#/$defs/image", "description": "A picture the whole exercise refers to, e.g. a map or a diagram." }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["cloze", "matching", "ordering", "trueFalse", "freeText", "multipleChoice", "wordSearch", "fallingWords", "vocabulary"] }
      },
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "if": { "properties": { "type": { "const": "cloze" } } }, "then": { "$ref": "#/$defs/cloze" } },
        { "if": { "properties": { "type": { "const": "matching" } } }, "then": { "$ref": "#/$defs/matching" } },
        { "if": { "properties": { "type": { "const": "ordering" } } }, "then": { "$ref": "#/$defs/ordering" } },
        { "if": { "properties": { "type": { "const": "trueFalse" } } }, "then": { "$ref": "#/$defs/trueFalse" } },
        { "if": { "properties": { "type": { "const": "freeText" } } }, "then": { "$ref": "#/$defs/freeText" } },
        { "if": { "properties": { "type": { "const": "multipleChoice" } } }, "then": { "$ref": "#/$defs/multipleChoice" } },
        { "if": { "properties": { "type": { "const": "wordSearch" } } }, "then": { "$ref": "#/$defs/wordSearch" } },
        { "if": { "properties": { "type": { "const": "fallingWords" } } }, "then": { "$ref": "#/$defs/fallingWords" } },
        { "if": { "properties": { "type": { "const": "vocabulary" } } }, "then": { "$ref": "#/$defs/vocabulary" } }
      ]
    },
    "cloze": {
      "description": "Gap text. Every ___ in text is a gap; gaps[i] belongs to the i-th gap.",
      "required": ["text", "gaps"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "___" },
        "wordBank": {
          "description": "If present, gaps are shown as drop-downs with these words. Otherwise as text inputs.",
          "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "gaps": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["answers"], "additionalProperties": false, "properties": { "answers": { "$ref": "#/$defs/answerList" } } }
        }
      },
      "additionalProperties": false
    },
    "matching": {
      "description": "Every row gets one of the options via a drop-down. An option may fit several rows.",
      "required": ["options", "rows"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "rows": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text", "answer"], "additionalProperties": false,
            "properties": { "text": { "$ref": "#/$defs/text" }, "answer": { "type": "string" }, "explanation": { "$ref": "#/$defs/text" }, "image": { "$ref": "#/$defs/image" } }
          }
        }
      },
      "additionalProperties": false
    },
    "ordering": {
      "description": "Steps in the CORRECT order; the app shuffles them.",
      "required": ["steps"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "steps": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      },
      "additionalProperties": false
    },
    "trueFalse": {
      "required": ["statements"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "statements": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text", "isTrue"], "additionalProperties": false,
            "properties": { "text": { "$ref": "#/$defs/text" }, "isTrue": { "type": "boolean" }, "explanation": { "$ref": "#/$defs/text" }, "image": { "$ref": "#/$defs/image" } }
          }
        }
      },
      "additionalProperties": false
    },
    "freeText": {
      "description": "Text inputs. With anyOrder, every correct answer may be in any field, but each counts only once, and so does a word typed twice.",
      "required": ["fields"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "anyOrder": { "type": "boolean", "default": false },
        "fields": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "required": ["answers"], "additionalProperties": false,
            "properties": { "label": { "type": "string", "maxLength": 120 }, "answers": { "$ref": "#/$defs/answerList" } }
          }
        }
      },
      "additionalProperties": false
    },
    "multipleChoice": {
      "description": "correct is the index (from 0) of the correct option, or a list of indices when several are correct.",
      "required": ["questions"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "questions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text", "options", "correct"], "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/choiceOption" } },
              "correct": {
                "oneOf": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
                ]
              },
              "explanation": { "$ref": "#/$defs/text" },
              "image": { "$ref": "#/$defs/image", "description": "A picture the question is about." }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "wordSearch": {
      "description": "Word search: the app hides the words in a new grid of letters every round; the child taps the first and the last letter of each word.",
      "required": ["words"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "words": {
          "description": "The words to find: letters only (umlauts and ß are fine), no spaces or hyphens, at most as long as the grid.",
          "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "minLength": 2, "maxLength": 14 }
        },
        "size": { "type": "integer", "minimum": 5, "maximum": 14, "description": "Rows and columns of the grid. Without it, the app picks a size that fits the words (8 to 12). It grows if the words do not fit." },
        "level": {
          "enum": ["easy", "medium", "hard"], "default": "easy",
          "description": "easy: left to right and top to bottom, words never cross. medium: also diagonal, words may cross. hard: also backwards. diagonal, backwards and overlap override it."
        },
        "diagonal": { "type": "boolean", "description": "Words may also run diagonally. Default from level (medium and hard)." },
        "backwards": { "type": "boolean", "description": "Words may also run backwards (right to left, bottom to top). Default from level (hard)." },
        "overlap": { "type": "boolean", "description": "Words may cross and share a letter. Default from level (medium and hard)." }
      },
      "additionalProperties": false
    },
    "fallingWords": {
      "description": "Game: the words fall down one after the other; the child taps the option at the bottom that each word belongs to before it hits the ground.",
      "required": ["options", "words"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "options": {
          "description": "The categories or short descriptions shown at the bottom. Keep them short: up to four share a phone's width.",
          "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "words": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object", "required": ["text", "answer"], "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 40 },
              "answer": { "type": "string", "description": "Exactly one of the options." },
              "explanation": { "$ref": "#/$defs/text" },
              "image": { "$ref": "#/$defs/image" }
            }
          }
        },
        "level": {
          "enum": ["easy", "medium", "hard"], "default": "easy",
          "description": "easy: 2 options per word, the first word falls in 10 s. medium: 3 options, 8 s. hard: 4 options, 6 s. Every word caught makes the next one a little faster."
        }
      },
      "additionalProperties": false
    },
    "vocabulary": {
      "description": "Vocabulary test: the child types the translation of each word, or the word for each translation, or both. Each question is a part; an answer counts when it is spelled right (a capital first letter, extra spaces and a full stop at the end don't matter).",
      "required": ["wordLanguage", "words"],
      "properties": {
        "id": true, "type": true, "instruction": true, "hint": true, "points": true, "explanation": true, "solutionText": true, "image": true,
        "wordLanguage": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 tag of the words, e.g. 'nl' or 'en'. The device reads them aloud in this language." },
        "translationLanguage": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 tag of the translations. Default: the file's language." },
        "direction": {
          "enum": ["both", "wordToTranslation", "translationToWord"], "default": "both",
          "description": "wordToTranslation: the word is shown and the translation typed. translationToWord: the other way. both: both ways."
        },
        "words": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/vocabularyWord" } }
      },
      "additionalProperties": false
    },
    "vocabularyWord": {
      "description": "A word in the language being learned and its translation. The alternatives also count as right when typed, e.g. without the article or a synonym.",
      "type": "object", "required": ["word", "translation"], "additionalProperties": false,
      "properties": {
        "word": { "type": "string", "minLength": 1, "maxLength": 100, "description": "In wordLanguage, e.g. 'de hond'." },
        "translation": { "type": "string", "minLength": 1, "maxLength": 100, "description": "In translationLanguage, e.g. 'der Hund'." },
        "wordAlternatives": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "translationAlternatives": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "image": { "$ref": "#/$defs/image", "description": "A picture of the word, shown with the question either way." }
      }
    },
    "choiceOption": {
      "description": "An option: a text, or a picture with an optional text under it.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object", "required": ["image"], "additionalProperties": false,
          "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 200 }, "image": { "$ref": "#/$defs/image" } }
        }
      ]
    },
    "image": {
      "description": "A picture uploaded together with the JSON. src is the file's path relative to the JSON file; PNG, JPEG, GIF, WebP and SVG are accepted (SVG without scripts or outside links).",
      "type": "object", "required": ["src", "alt"], "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string", "minLength": 1, "maxLength": 200,
          "pattern": "^[A-Za-z0-9ÄÖÜäöüß_-][A-Za-z0-9ÄÖÜäöüß_. -]*(/[A-Za-z0-9ÄÖÜäöüß_-][A-Za-z0-9ÄÖÜäöüß_. -]*)*$",
          "description": "Relative path of the picture file, e.g. 'plants/rose.jpg'. No URLs, no leading '/', no '..'."
        },
        "alt": { "type": "string", "minLength": 1, "maxLength": 200, "description": "What the picture shows, in the content language. Read by screen readers and shown when the picture is missing." },
        "caption": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Text under the picture." },
        "credit": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Source and licence, e.g. 'Wikimedia Commons, CC0'." }
      }
    }
  }
}
