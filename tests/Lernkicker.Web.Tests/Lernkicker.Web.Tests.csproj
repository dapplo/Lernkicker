<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lernkicker.Web\Lernkicker.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Examples.cs" Link="Examples.cs" />
    <None Include="..\..\quizzes\**\*.json" LinkBase="quizzes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\lessons\**\*.json" LinkBase="lessons" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pictures of the examples with pictures -->
    <None Include="..\..\quizzes\**\*.svg;..\..\quizzes\**\*.png" LinkBase="quizzes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\lessons\**\*.svg;..\..\lessons\**\*.png" LinkBase="lessons" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schema\quiz-v1.schema.json" Link="quiz-v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schema\lesson-v1.schema.json" Link="lesson-v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
